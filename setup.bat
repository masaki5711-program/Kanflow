@echo off
chcp 65001 >nul 2>&1
setlocal enabledelayedexpansion

echo ============================================
echo   Scrum Tool (KanFlow) - セットアップ
echo ============================================
echo.

:: -----------------------------------------------
:: 1. 前提条件チェック
:: -----------------------------------------------
echo [1/5] 前提条件を確認中...

where git >nul 2>&1
if %errorlevel% neq 0 (
    echo [ERROR] Git がインストールされていません。
    echo         https://git-scm.com/downloads からインストールしてください。
    goto :error
)
echo   [OK] Git

where docker >nul 2>&1
if %errorlevel% neq 0 (
    echo [ERROR] Docker がインストールされていません。
    echo         https://www.docker.com/products/docker-desktop/ からインストールしてください。
    goto :error
)
echo   [OK] Docker

:: Docker Desktop が起動しているか確認
docker info >nul 2>&1
if %errorlevel% neq 0 (
    echo [ERROR] Docker Desktop が起動していません。
    echo         Docker Desktop を起動してから再実行してください。
    goto :error
)
echo   [OK] Docker Desktop 起動中
echo.

:: -----------------------------------------------
:: 2. リポジトリ取得
:: -----------------------------------------------
echo [2/5] リポジトリを取得中...

set REPO_URL=https://gitlab.scm.service.infosys.yamaha.com/ymma/stragegic-planning/appications/kanflow.git
set APP_DIR=kanflow

if exist "%APP_DIR%\.git" (
    echo   既にクローン済み。最新を取得します...
    pushd "%APP_DIR%"
    git pull origin main
    popd
) else if exist "%APP_DIR%" (
    echo [ERROR] %APP_DIR% フォルダが既に存在しますが、Gitリポジトリではありません。
    echo         フォルダを削除するか別の場所で実行してください。
    goto :error
) else (
    git clone %REPO_URL% %APP_DIR%
)

if %errorlevel% neq 0 (
    echo [ERROR] リポジトリの取得に失敗しました。
    echo         ネットワーク接続とGitLabへのアクセス権を確認してください。
    goto :error
)
echo   [OK] リポジトリ取得完了
echo.

:: -----------------------------------------------
:: 3. .env ファイル作成
:: -----------------------------------------------
pushd "%APP_DIR%"

echo [3/5] 環境設定ファイルを準備中...

if exist .env (
    echo   [OK] .env は既に存在します（スキップ）
    goto :skip_env
)

if not exist .env.example (
    echo [ERROR] .env.example が見つかりません。
    goto :error_pop
)

:: .env.example をベースに、デフォルト値を埋めた .env を生成
echo   .env ファイルを生成します...

:: ランダムなパスワードとシークレットを生成
set "CHARS=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
call :generate_password ROOT_PW
call :generate_password APP_PW
call :generate_password COLLABORA_PW
call :generate_password SECRET1
call :generate_password SECRET2

(
    echo # ===========================================
    echo # Docker Compose environment variables
    echo # Auto-generated by setup.bat
    echo # ===========================================
    echo.
    echo # MySQL
    echo MYSQL_ROOT_PASSWORD=!ROOT_PW!
    echo MYSQL_DATABASE=scrum_tool
    echo MYSQL_APP_USER=scrum_app
    echo MYSQL_APP_PASSWORD=!APP_PW!
    echo.
    echo # NextAuth
    echo NEXTAUTH_URL=http://localhost:3000
    echo NEXTAUTH_SECRET=!SECRET1!!SECRET2!
    echo.
    echo # Collabora Online
    echo COLLABORA_ADMIN_USER=admin
    echo COLLABORA_ADMIN_PASSWORD=!COLLABORA_PW!
    echo.
    echo # Collabora / WOPI
    echo NEXT_PUBLIC_COLLABORA_URL=http://localhost:9980
    echo APP_EXTERNAL_URL=http://scrum-app:3000
) > .env

echo   [OK] .env を自動生成しました（パスワードはランダム値）
:skip_env
echo.

:: -----------------------------------------------
:: 4. Docker ビルド＆起動
:: -----------------------------------------------
echo [4/5] Docker コンテナをビルド＆起動中...
echo   （初回は数分かかります。しばらくお待ちください...）
echo.

docker compose up --build -d

if %errorlevel% neq 0 (
    echo.
    echo [ERROR] Docker の起動に失敗しました。
    echo         docker compose logs で詳細を確認してください。
    goto :error_pop
)
echo.

:: -----------------------------------------------
:: 5. 起動確認
:: -----------------------------------------------
echo [5/5] 起動を確認中...

:: アプリコンテナのログを待つ (最大60秒)
set /a count=0
:wait_loop
if !count! geq 60 (
    echo   [WARN] タイムアウト。ログを確認してください: docker compose logs app
    goto :done
)
docker compose logs app 2>&1 | findstr /c:"Ready in" >nul 2>&1
if %errorlevel% equ 0 (
    goto :ready
)
timeout /t 2 /nobreak >nul
set /a count+=2
echo   起動待ち... (%count%秒)
goto :wait_loop

:ready
echo   [OK] アプリケーション起動完了！
echo.

:done
echo ============================================
echo   セットアップ完了！
echo ============================================
echo.
echo   アプリ:     http://localhost:3000
echo   Collabora:  http://localhost:9980
echo.
echo   ログ確認:   docker compose logs -f
echo   停止:       docker compose down
echo   再起動:     docker compose up -d
echo ============================================

popd
endlocal
exit /b 0

:: -----------------------------------------------
:: パスワード生成サブルーチン (16文字)
:: -----------------------------------------------
:generate_password
set "_pw="
for /L %%i in (1,1,16) do (
    set /a "_idx=!random! %% 62"
    for %%j in (!_idx!) do set "_pw=!_pw!!CHARS:~%%j,1!"
)
set "%1=!_pw!"
exit /b

:error_pop
popd
:error
echo.
echo セットアップに失敗しました。上記のエラーを確認してください。
endlocal
pause
exit /b 1
