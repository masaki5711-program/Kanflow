app/.next/
app/.next-*/
app/out/
app/coverage/
app/playwright-report/
app/test-results/
app/e2e/.auth/

# Prisma
app/src/generated/

# Uploads
app/private/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code
.claude/

# Separate projects (root-level only — do NOT match app/src/app/api)
/api/
/scripts/

# Excel
*.xlsx
*.xls

# Misc
*.log
*.log.[0-9]*
*.bak
*.db

# Local data and secrets
mysql-data/
.db-pw

# Local working notes
memo.txt
RESUME-STATE.md

ai-activity.log

# Ops runtime artefacts (logs, watchdog state, restore safety dumps, backups)
ops/logs/*.log*
ops/logs/*.json
ops/restore-safety/
ops/watchdog/MAINTENANCE
backups/
ops/backup/daemon-snapshot-*/
ops/backup/node_modules-*/
# node-windows service wrappers (winsw exe/xml + wrapper logs), generated on install
ops/web/daemon/
ops/worker/daemon/
# app runtime logs + worker heartbeat file (logs/worker-heartbeat.json)
app/logs/
*.sql.gz
app/private.pre-restore-*/
app/.env.pre-restore-*
app/prisma.ci.config.ts
