# Kanflow — Docker / Rancher Desktop deployment configuration.
# Copy to `.env` in the repo root before running `docker compose up`.
#   cp .env.docker.example .env
# DO NOT commit the resulting .env to git — it contains secrets.

###################
# Database (MySQL)
###################
MYSQL_ROOT_PASSWORD=replace-me-with-a-strong-root-password
MYSQL_DATABASE=scrum_tool
MYSQL_APP_USER=scrum_app
MYSQL_APP_PASSWORD=replace-me-with-a-strong-app-password

###################
# NextAuth (auth.js)
###################
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-32-byte-base64-secret
# External URL clients hit (use the host's reachable address for LAN access).
NEXTAUTH_URL=http://localhost:3000
# Used by the app for absolute callback URLs.
APP_EXTERNAL_URL=http://localhost:3000

###################
# Collabora (LibreOffice Online)
###################
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=replace-me
NEXT_PUBLIC_COLLABORA_URL=http://localhost:9980

###################
# Ollama (local LLM)
###################
# Ollama runs on the HOST (not in a container) so it can use the GPU.
# The default points to host.docker.internal:11434 which resolves to the host
# on Rancher Desktop / Docker Desktop / Linux (via extra_hosts).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_TRANSLATE=qwen3.8:27b-q4_K_M
OLLAMA_MODEL_VISION=qwen2.5vl:7b
OLLAMA_MODEL_ANALYSIS=qwen3.8:27b-q4_K_M
