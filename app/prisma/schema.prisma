generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  /// partialIndexes: FieldTranslation's English-backfill index (WHERE clause).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                   @id @default(cuid())
  name              String
  /// citext: unique and compared case-insensitively, as under MySQL utf8mb4_unicode_ci (login, invites).
  email             String                   @unique @db.Citext
  password          String
  avatarUrl         String?                  @db.Text
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  isActive          Boolean                  @default(true)
  role              String                   @default("member")
  /// Bumped to revoke every JWT issued for this user (deactivate / role change / password reset).
  tokenVersion      Int                      @default(0)
  language          String                   @default("ja")
  employeeNumber    String?                  @unique @db.Citext
  department        String?
  accounts          Account[]
  memberships       ProjectMember[]
  sessions          Session[]
  projectCategories UserProjectCategory[]
  sections          UserSection[]
  favoriteProjects  UserProjectFavorite[]
  fixedTasks        UserFixedTask[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  comments          Comment[]
  commentMentions   CommentMention[]
  taskAssignments   TaskAssignee[]
  chatThreads       ChatThread[]
  aiJobs            AiJob[]
  ownedPlanItems    PlanItem[]               @relation("PlanItemOwner")
  apiTokens         ApiToken[]
  /// Work claims (作業の宣言) made through a dev:write token.
  workClaims        WorkClaim[]
  failureEvents     FailureEvent[]
  confirmedLessons  Lesson[]                 @relation("LessonConfirmedBy")
  /// 稼働量 (plan 12 E4): own FTE and project allocations.
  capacities        MemberCapacity[]
  capacityAudits    MemberCapacityAudit[]    @relation("MemberCapacityAuditSubject")
  capacityAuditsBy  MemberCapacityAudit[]    @relation("MemberCapacityAuditActor")
  estimateGateApprovals PlanEstimateGateApproval[] @relation("PlanEstimateGateApprovedBy")
  estimateGateEnds      PlanEstimateGateApproval[] @relation("PlanEstimateGateEndedBy")
  estimateParamDecisions PlanEstimateParamProposal[] @relation("PlanEstimateParamDecidedBy")
  actualsReviewDecisions PlanActualsReviewProposal[] @relation("PlanActualsReviewDecidedBy")
  estimateParamApprovals PlanEstimateParamApproval[] @relation("PlanEstimateParamApprovedBy")
  estimateParamEnds      PlanEstimateParamApproval[] @relation("PlanEstimateParamEndedBy")
  estimateRuns      PlanEstimateRun[]        @relation("PlanEstimateRunCreatedBy")
  estimateFeedback  PlanEstimateFeedback[]   @relation("PlanEstimateFeedbackBy")
  /// Merge request links declared through a dev:write token.
  declaredGitLinks  GitLink[]                @relation("GitLinkDeclaredBy")
  gitApprovalAttempts GitMrApprovalAttempt[]

  projectVisits ProjectVisit[]

  teamMessages        TeamMessage[]
  reactions           Reaction[]
  teamMessageMentions TeamMessageMention[]
  teamChatReads       TeamChatRead[]

  @@index([department])
}

/// A user-defined group of related sprint sub-tasks. `taskName` is the group's
/// display name (e.g. "設備購入"); children in `items` are the concrete sub-tasks
/// that get bulk-inserted under a single PBI when the group is picked from
/// the dropdown in the sprint task form.
/// A row in the project's master plan ("全体計画"). Unlimited nesting via
/// parentId. Leaves take progress from their status (progressMode "manual")
/// or from the PBIs linked to them ("linked"); parents roll up progress,
/// status and planned dates from their children (src/lib/plan-progress.ts).
/// Delay is computed (scheduleState), not stored: "delayed" is no longer a
/// status (migrated to "in_progress" in 20261004000000_plan_linkage).
model PlanItem {
  id                    String    @id @default(cuid())
  projectId             String
  parentId              String?
  name                  String    @db.VarChar(255)
  description           String?   @db.Text
  /// Null = 日程未定 (undated, e.g. a stage just loaded from a plan template).
  /// Both are set or both are null; a parent's span is derived from its dated children.
  plannedStart          DateTime?
  plannedEnd            DateTime?
  actualStart           DateTime?
  actualEnd             DateTime?
  progressPct           Int       @default(0)
  color                 String?   @db.VarChar(32)
  status                String    @default("not_started")
  sortOrder             Int       @default(0)
  isMilestone           Boolean   @default(false)
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  /// "manual" (status → %) | "linked" (% from linked PBIs; leaves only).
  progressMode          String    @default("manual") @db.VarChar(16)
  /// Optimistic-lock counter: bumped on every user update; stale writes get 409.
  version               Int       @default(0)
  baselineStart         DateTime?
  baselineEnd           DateTime?
  ownerId               String?
  deletedAt             DateTime?
  deletedById           String?
  /// 目安期間 (days) copied from a plan template stage; used by 「日程を仮置き」.
  durationDays          Int?
  /// The template load that created this row (null for hand-made rows).
  templateApplicationId String?
  /// Key of the schedule / template item this row was created from (plan 12 E0; null = hand-made or unknown).
  /// Written by POST /plan/load on every created row; backfilled for template loads by
  /// scripts/backfill-plan-template-keys.ts. Lets finished projects be matched item by item to their template.
  templateKey           String?   @db.VarChar(40)
  /// The base-schedule load (plan_schedule_load) that created this row (plan 12 E0).
  scheduleLoadId        String?

  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateApplication PlanTemplateApplication?  @relation(fields: [templateApplicationId], references: [id], onDelete: SetNull)
  scheduleLoad        PlanScheduleLoad?         @relation(fields: [scheduleLoadId], references: [id], onDelete: SetNull)
  parent              PlanItem?                 @relation("PlanItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children            PlanItem[]                @relation("PlanItemTree")
  owner               User?                     @relation("PlanItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  backlogItems        ProductBacklogItem[]
  successorDeps       PlanItemDependency[]      @relation("PlanDependencyPredecessor")
  predecessorDeps     PlanItemDependency[]      @relation("PlanDependencySuccessor")
  /// マイルストーン・検収ボード rows attached to this stage.
  checklistStates     MilestoneChecklistState[]
  acceptanceChecks    AcceptanceCheck[]
  punchItems          PunchItem[]

  @@index([projectId])
  @@index([parentId])
  @@index([projectId, sortOrder])
  @@index([projectId, deletedAt])
  @@index([ownerId])
  @@index([templateApplicationId])
  @@index([scheduleLoadId])
}

/// One base-schedule load into 全体計画 (POST /plan/load, W12; plan 12 E0): what was loaded, from where, and
/// with which start date, so a finished project can later be compared item by item with its template
/// (PlanItem.templateKey + scheduleLoadId). Written in the load's transaction: no record, no rows.
/// The user is referenced by id (no FK, like plan templates).
model PlanScheduleLoad {
  id            String   @id @default(cuid())
  projectId     String
  /// The approved chat proposal (null = loaded without one). Unique per project: a proposal loads once.
  proposalId    String?  @db.VarChar(64)
  /// Where the schedule came from, as the caller supplied it (validated): gitstation:<repo>@<tag>:<path> |
  /// template:<id>@v<n> (src/lib/plan-schedule/schedule-source.ts). Null = not given.
  sourceRef     String?  @db.VarChar(300)
  /// Template family name stable across versions (given, or derived: schedule-source.ts defaultLineage).
  lineage       String   @db.VarChar(200)
  /// sha256 (hex) of the canonical JSON of `content`.
  scheduleHash  String   @db.Char(64)
  /// The schedule as loaded (BaseSchedule JSON).
  content       Json
  startDate     DateTime @db.Date
  skipWeekends  Boolean  @default(false)
  /// Estimate run that produced the schedule (plan 12 E5); kept as history when the run is purged (SET NULL).
  estimateRunId String?  @db.VarChar(191)
  loadedById    String?
  loadedAt      DateTime @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planItems   PlanItem[]
  estimateRun PlanEstimateRun? @relation(fields: [estimateRunId], references: [id], onDelete: SetNull)

  /// Also serves lookups by projectId (leading column), so there is no separate (projectId) index.
  @@unique([projectId, proposalId])
  @@index([lineage])
  @@map("plan_schedule_load")
}

/// 実績のスナップショット (plan 12 §2.2, E1): the frozen actuals of a finished project, written when the PO / SM
/// presses 実績を確定 (`plan.actualsFinalize`). Rows are never rewritten: finalizing again adds a new snapshot and sets
/// `supersededAt` on the old one. The two exceptions are `includeInLearning` (a PO / SM switch, audited) and the
/// admin pseudonymisation of `plan_actuals_item.ownerId` (audited). Confidentiality is NOT stored: the cited PBIs are
/// kept per leaf and re-checked at every use (src/services/plan-actuals: `learnableItemFacts`).
model PlanActualsSnapshot {
  id                String    @id @default(cuid())
  projectId         String
  projectType       String    @db.VarChar(40)
  /// Lineage of the latest base-schedule load (plan_schedule_load), or "manual:<projectId>" without one.
  lineage           String    @db.VarChar(200)
  scheduleLoadId    String?   @db.VarChar(191)
  scheduleHash      String?   @db.Char(64)
  skipWeekends      Boolean   @default(false)
  /// The day the work ended (latest actual end of a leaf; the finalize day when none).
  closedAt          DateTime  @db.Date
  /// The project's FIRST finalization (kept across re-finalizations: the "oldest first" order of plan 12 §3.2).
  firstFinalizedAt  DateTime
  finalizedAt       DateTime  @default(now())
  finalizedById     String?
  repoCount         Int       @default(0)
  /// Items to check that the finalizer acknowledged (the count they were shown).
  issueCount        Int       @default(0)
  includeInLearning Boolean   @default(true)
  /// e1-v1 — bumped when a formula of src/lib/plan-actuals changes.
  methodVersion     String    @db.VarChar(16)
  /// Optimistic lock of the includeInLearning switch.
  version           Int       @default(0)
  supersededAt      DateTime?
  /// The finalizer's note (確定の時のメモ, up to 2000 chars): project-internal text, a source of LLM rule drafts (E6).
  finalizeNote      String?   @db.Text

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items         PlanActualsItem[]
  ruleDraftJobs PlanRuleDraftJob[]
  reviewJobs    PlanActualsReviewJob[]
  reviewProposals PlanActualsReviewProposal[]

  /// UNIQUE NULLS NOT DISTINCT in the migration: at most ONE current (supersededAt IS NULL) snapshot per project,
  /// whatever path writes (Prisma does not model NULLS NOT DISTINCT).
  @@unique([projectId, supersededAt], map: "plan_actuals_snapshot_one_current_key")
  @@index([lineage, supersededAt])
  @@index([projectType, supersededAt])
  @@map("plan_actuals_snapshot")
}

/// One leaf of a snapshot (plan 12 §2.2 table). PBI-derived numbers are NOT here: they live per PBI in
/// plan_actuals_item_pbi / _repo and are summed at use time over the PBIs that are not confidential now.
model PlanActualsItem {
  id                   String  @id @default(cuid())
  snapshotId           String
  /// The plan row (plain id: the plan may be edited or trashed later).
  planItemId           String  @db.VarChar(191)
  templateKey          String? @db.VarChar(40)
  name                 String  @db.VarChar(255)
  parentKey            String? @db.VarChar(40)
  isMilestone          Boolean @default(false)
  /// The schedule item's role (from the loaded content); what the evidence screen shows instead of the owner.
  role                 String? @db.VarChar(32)
  templateDays         Int?
  plannedDays          Int?
  actualDays           Int?
  /// Both actual dates, start ≤ end, not over 5 × baseline: usable for learning.
  complete             Boolean @default(false)
  startSlipDays        Int?
  endSlipDays          Int?
  waitGapDays          Int?
  onHoldDays           Int?
  /// The owner's user id (m_u learning only; never shown). Pseudonymised by an admin to "role:<name>".
  ownerId              String? @db.VarChar(191)
  ownerConcurrentAvg   Float?
  ownerConcurrentPeak  Int?
  /// C-3 merge-order warnings (null until C-3 exists).
  mergeOrderViolations Int?
  /// How learning uses this leaf, set only when a PO / SM accepts an AI review proposal (plan_actuals_review_proposal;
  /// audited, like includeInLearning): null = as recorded | excluded (not learned from) | waiting (the overrun over the
  /// planned days is learned as waiting before the leaf, not as work). The recorded numbers never change.
  learningUse          String? @db.VarChar(16)
  /// The plan row's description and notes AS FINALIZED (up to 1000 chars): what the AI review reads and quotes, so a
  /// later edit of the live plan cannot steer it. Null on leaves finalized before it was recorded.
  notes                String? @db.Text

  snapshot        PlanActualsSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  pbis            PlanActualsItemPbi[]
  repos           PlanActualsItemRepo[]
  reviewProposals PlanActualsReviewProposal[]

  @@index([snapshotId])
  @@index([templateKey])
  @@index([ownerId])
  @@map("plan_actuals_item")
}

/// Leaf × PBI (plan 12 §2.2): the PBI's numbers at finalize time; joined with the CURRENT confidential flag at use.
model PlanActualsItemPbi {
  id                 String  @id @default(cuid())
  snapshotItemId     String
  /// Plain id: a PBI that is gone counts as confidential at use time.
  backlogItemId      String  @db.VarChar(191)
  effortHours        Float?
  estimatedHours     Float?
  reworkCount        Int     @default(0)
  mrSetLeadTimeHours Float?
  /// Merged MRs of the PBI's set; null = a bound repository could not be read.
  mrCount            Int?

  item PlanActualsItem @relation(fields: [snapshotItemId], references: [id], onDelete: Cascade)

  @@unique([snapshotItemId, backlogItemId])
  @@index([backlogItemId])
  @@map("plan_actuals_item_pbi")
}

/// Leaf × PBI × repository (plan 12 §2.4): one row per repository the PBI's MRs touched.
model PlanActualsItemRepo {
  id               String  @id @default(cuid())
  snapshotItemId   String
  backlogItemId    String  @db.VarChar(191)
  repositoryId     String  @db.VarChar(191)
  /// The repository's path ("group/repo"); shown only to readers who can read it (plan 12 §4).
  repositoryRef    String  @db.VarChar(512)
  /// Null = the repository could not be read at finalize time (unknown, not zero).
  mrCount          Int?
  leadTimeP50Hours Float?
  additions        Int?
  deletions        Int?
  versionCount     Int?

  item PlanActualsItem @relation(fields: [snapshotItemId], references: [id], onDelete: Cascade)

  @@unique([snapshotItemId, backlogItemId, repositoryId])
  @@index([backlogItemId])
  @@map("plan_actuals_item_repo")
}

/// 稼働量 (plan 12 §2.1 / §3.5, E4): how much of a person's working day is available. `projectId` null = the
/// person's own FTE (set by themselves, their section manager or an admin: `canManageUserCapacity`); set = their
/// allocation to that project (set by the project's PO / SM: `capacity.manage`). Without a row the FTE is 1.0.
/// Deliberately NO free-text column (plan 12 §4): reasons for leave must not be stored here.
model MemberCapacity {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  /// First day the value applies (calendar day).
  from        DateTime  @db.Date
  /// Last day (inclusive); null = open-ended.
  to          DateTime? @db.Date
  /// 0..1 of a working day (7.5 h).
  fte         Float
  createdById String?
  version     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, from])
  @@index([projectId, userId])
  @@map("member_capacity")
}

/// Who changed a 稼働量 row, when, and the period / FTE before and after (plan 12 E4). Kept when the row is deleted;
/// numbers only (no free text exists to copy). Written in the same transaction as the change.
model MemberCapacityAudit {
  id         String   @id @default(cuid())
  capacityId String
  userId     String
  /// null = the person's own FTE row.
  projectId  String?
  actorId    String?
  /// create | update | delete
  op         String   @db.VarChar(16)
  /// { from, to, fte } before the change (null for create).
  before     Json?
  /// { from, to, fte } after the change (null for delete).
  after      Json?
  createdAt  DateTime @default(now())

  user  User  @relation("MemberCapacityAuditSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("MemberCapacityAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("member_capacity_audit")
}

/// 設備・工程・タグ of a project (plan 12 §2.1, Q5: free strings until a master exists). Used for matching (E2).
model ProjectAttribute {
  id        String   @id @default(cuid())
  projectId String
  /// equipment | process | tag
  kind      String   @db.VarChar(16)
  ref       String   @db.VarChar(200)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, ref])
  @@map("project_attribute")
}

/// 反省点の規則 (plan 12 §2.3, E3): one of the six fixed rule kinds (src/lib/plan-lesson-rules/rules.ts) that may
/// change a base schedule. Only `confirmed` rules change a plan; where a rule applies is decided at use time
/// (src/lib/plan-lesson-rules/scope.ts), and cited sources are re-checked for confidentiality each time (never
/// frozen). Users are plain ids (no FK), like the other audit columns. CHECK constraints in the migration.
model PlanLessonRule {
  id                     String    @id @default(cuid())
  /// scale_duration | add_buffer | add_prerequisite | add_dependency | split | cap_parallel
  kind                   String    @db.VarChar(32)
  /// The kind's params, validated with its zod schema on every write and every read.
  params                 Json
  /// project (only the source project) | shared (lineage / project type; admins only)
  scope                  String    @default("project") @db.VarChar(16)
  sourceProjectId        String
  /// `shared` filters: the rule applies where every non-null filter matches. Both null for `project`.
  lineage                String?   @db.VarChar(200)
  projectType            String?   @db.VarChar(40)
  /// draft → confirmed → retired (a draft may also be retired)
  state                  String    @default("draft") @db.VarChar(16)
  /// W11 lesson the rule came from (no FK: a lesson that is gone counts as confidential).
  sourceLessonId         String?   @db.VarChar(191)
  /// PBIs of the source project the rule came from (no FK: a PBI that is gone or trashed counts as confidential).
  sourceBacklogItemIds   String[]  @default([])
  /// Sprint whose retrospective the rule came from: project-internal text, so the rule stays `project` scope.
  sourceSprintId         String?   @db.VarChar(191)
  /// Quoted source text. Shown inside the source project only; removed when the rule is promoted.
  quote                  String?   @db.Text
  /// human | llm (E6)
  createdByKind          String    @default("human") @db.VarChar(8)
  createdById            String?
  confirmedById          String?
  confirmedAt            DateTime?
  /// Promotion request by the source project's PO (target filters), confirmed or rejected by an admin.
  promotionLineage       String?   @db.VarChar(200)
  promotionProjectType   String?   @db.VarChar(40)
  promotionRequestedById String?
  promotionRequestedAt   DateTime?
  promotedById           String?
  promotedAt             DateTime?
  retiredById            String?
  retiredAt              DateTime?
  /// Optimistic lock: every change bumps it; a write naming an older version is refused (409).
  version                Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  sourceProject Project @relation(fields: [sourceProjectId], references: [id], onDelete: Cascade)

  @@index([sourceProjectId, state])
  @@index([scope, state])
  @@map("plan_lesson_rule")
}

/// Reusable rough plan (大枠の計画) loaded into 全体計画 as undated stages.
/// builtinKey set = one of the shipped 共通 templates (seeded lazily from
/// src/lib/plan-templates/builtins.ts; editable, resettable, never deleted).
/// content = PlanTemplateContent JSON (stages + checks / documents for the
/// マイルストーン・検収ボード). Users are referenced by id + name (no FK).
model PlanTemplate {
  id            String    @id @default(cuid())
  builtinKey    String?   @unique @db.VarChar(40)
  name          String    @db.VarChar(255)
  description   String?   @db.Text
  /// public | private (private = owner + admins only)
  visibility    String    @default("public") @db.VarChar(10)
  ownerId       String?
  ownerName     String?   @db.VarChar(255)
  content       String    @db.Text
  version       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  updatedById   String?
  updatedByName String?   @db.VarChar(255)
  deletedAt     DateTime?

  revisions    PlanTemplateRevision[]
  applications PlanTemplateApplication[]

  @@index([deletedAt, visibility])
  @@index([ownerId])
  @@map("plan_template")
}

/// Snapshot of a template after each save / reset (edit history).
model PlanTemplateRevision {
  id           String   @id @default(cuid())
  templateId   String
  version      Int
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  visibility   String   @db.VarChar(10)
  content      String   @db.Text
  /// create | update | reset | duplicate
  action       String   @db.VarChar(16)
  editedById   String?
  editedByName String?  @db.VarChar(255)
  editedAt     DateTime @default(now())

  template PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, editedAt])
  @@map("plan_template_revision")
}

/// One load of a template into a project's plan (duplicate-load warning and
/// the link from created PlanItems back to the template content they came from).
model PlanTemplateApplication {
  id              String   @id @default(cuid())
  projectId       String
  templateId      String
  templateName    String   @db.VarChar(255)
  templateVersion Int
  /// The template content as loaded (later template edits never change it).
  content         String   @db.Text
  /// JSON string[] of the top-level PlanItem ids created by this load.
  createdRootIds  String   @db.Text
  appliedById     String?
  appliedByName   String?  @db.VarChar(255)
  appliedAt       DateTime @default(now())

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template      PlanTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  planItems     PlanItem[]
  /// Set once the マイルストーン・検収ボード copied this load's checks / documents.
  milestoneSeed MilestoneBoardSeed?

  @@index([projectId, templateId])
  @@index([templateId])
  @@map("plan_template_application")
}

/// Finish-to-start dependency between two plan items of one project
/// (predecessor must finish before successor starts). Informational only:
/// nothing is auto-scheduled.
model PlanItemDependency {
  id            String   @id @default(cuid())
  projectId     String
  predecessorId String
  successorId   String
  createdAt     DateTime @default(now())

  predecessor PlanItem @relation("PlanDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   PlanItem @relation("PlanDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([successorId])
  @@index([projectId])
}

model UserFixedTask {
  id        String              @id @default(cuid())
  userId    String
  taskName  String
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     UserFixedTaskItem[]

  @@index([userId])
}

model UserFixedTaskItem {
  id        String        @id @default(cuid())
  groupId   String
  taskName  String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  group     UserFixedTask @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id                       String                          @id @default(cuid())
  name                     String
  description              String?                         @db.Text
  status                   String                          @default("active")
  defaultCapacity          Int                             @default(0)
  sprintDurationDays       Int                             @default(7)
  pointUnit                String                          @default("SP")
  pointDescription         String?                         @db.Text
  language                 String                          @default("ja")
  // Team option: when true, saved free-text fields are auto-annotated with a
  // Japanese/Indonesian bilingual rendering (lib/ensure-bilingual.ts)
  bilingualMode            Boolean                         @default(false)
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  projectType              String                          @default("software")
  progressPct              Int                             @default(0)
  // Card tint on the project list: gray|red|orange|yellow|green|blue|indigo|purple|pink; null = default white
  cardColor                String?
  // Soft delete (trash). Null = live. deletedById is a plain User id (no FK,
  // like CalendarEvent.createdBy); ActivityLog holds the full audit trail.
  deletedAt                DateTime?
  deletedById              String?
  /// P3: per-project AI surveillance thresholds as a JSON string (Text, like
  /// the other JSON-in-Text columns). Null = defaults (lib/surveillance-settings.ts).
  surveillanceSettings     String?                         @db.Text
  attachmentFolders        AttachmentFolder[]
  calendarEvents           CalendarEvent[]
  iceboxItems              IceboxItem[]
  backlogItems             ProductBacklogItem[]
  productGoals             ProductGoal[]
  attachments              ProjectAttachment[]
  members                  ProjectMember[]
  releaseItems             ReleaseBacklogItem[]
  sprints                  Sprint[]
  sections                 ProjectSection[]
  categoryAssignments      UserProjectCategoryAssignment[]
  adminCategoryAssignments AdminCategoryAssignment[]
  favoritedBy              UserProjectFavorite[]
  planItems                PlanItem[]
  aiReports                AiReport[]
  activityLogs             ActivityLog[]
  notifications            Notification[]
  comments                 Comment[]
  chatThreads              ChatThread[]
  aiJobs                   AiJob[]

  visits ProjectVisit[]

  teamMessages  TeamMessage[]
  teamChatReads TeamChatRead[]
  reactions     Reaction[]

  /// Optional GitLab integration (off by default; see services/git).
  gitIntegration  GitIntegration?
  gitRepositories GitRepository[]
  gitLinks        GitLink[]
  gitReleases     GitRelease[]
  gitApprovalAttempts GitMrApprovalAttempt[]
  workClaims      WorkClaim[]
  failureEvents   FailureEvent[]
  repoChunks      RepoChunk[]

  /// Plan template loads into this project's 全体計画.
  planTemplateApplications PlanTemplateApplication[]
  planScheduleLoads        PlanScheduleLoad[]
  /// 反省点の規則 drafted in this project (plan 12 E3).
  planLessonRules          PlanLessonRule[]
  /// 実績のスナップショット (plan 12 E1) and 設備・工程・タグ.
  planActualsSnapshots     PlanActualsSnapshot[]
  attributes               ProjectAttribute[]
  /// 稼働量: members' allocations to this project (plan 12 E4).
  memberCapacities         MemberCapacity[]
  /// 計画を作る (plan 12 E5): estimate runs of this project.
  planEstimateRuns         PlanEstimateRun[]
  /// Rule drafts requested at actuals finalization (plan 12 E6, night batch).
  planRuleDraftJobs        PlanRuleDraftJob[]
  planActualsReviewJobs    PlanActualsReviewJob[]
  planActualsReviewProposals PlanActualsReviewProposal[]

  /// マイルストーン・検収ボード (general projects).
  milestoneBoard    MilestoneBoard?
  milestoneSeeds    MilestoneBoardSeed[]
  acceptanceChecks  AcceptanceCheck[]
  punchItems        PunchItem[]
  handoverDocuments HandoverDocument[]
  budgetLines       BudgetLine[]
  milestoneMetrics  MilestoneMetric[]

  /// ボード (drawing boards, docs/plan/10-board.md).
  boards            Board[]

  @@index([deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Project_name_trgm_idx")
}

model AiReport {
  id         String   @id @default(cuid())
  projectId  String
  // What fired the investigation: surveillance | sprint_completed | manual
  trigger    String
  status     String   @default("done")
  title      String
  // One-line summary for list views
  summary    String?  @db.Text
  // Full markdown report produced by the agent (fallback rendering)
  body       String?  @db.Text
  // JSON: StructuredReport submitted via the submit_report tool (report-tool.ts).
  // Null for legacy reports / plain-text endings — the UI then renders body.
  structured String?  @db.Text
  // JSON: detected anomalies, tool call stats, duration ms
  meta       String?  @db.Text
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Section {
  id          String           @id @default(cuid())
