  name        String           @unique @db.Citext
  description String?          @db.Text
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserSection[]
  projects    ProjectSection[]
  categories  AdminCategory[]
}

model ProjectSection {
  projectId  String
  sectionId  String
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([projectId, sectionId])
  @@index([projectId])
  @@index([sectionId])
}

model UserSection {
  userId     String
  sectionId  String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
}

model UserProjectFavorite {
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model AdminCategory {
  id          String                    @id @default(cuid())
  /// citext: unique per section regardless of case (MySQL utf8mb4_unicode_ci parity).
  name        String                    @db.Citext
  color       String                    @default("gray")
  sortOrder   Int                       @default(0)
  sectionId   String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  section     Section?                  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignments AdminCategoryAssignment[]

  @@unique([sectionId, name])
  @@index([sectionId])
}

model AdminCategoryAssignment {
  id         String        @id @default(cuid())
  categoryId String
  projectId  String
  category   AdminCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([categoryId, projectId])
  @@index([categoryId])
  @@index([projectId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProductGoal {
  id           String               @id @default(cuid())
  projectId    String
  title        String               @db.Text
  description  String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  backlogItems ProductBacklogItem[]
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductGoal_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductGoal_description_trgm_idx")
}

model IceboxItem {
  id              String               @id @default(cuid())
  projectId       String
  displayId       Int
  author          String
  request         String               @db.Text
  background      String?              @db.Text
  policyDoc       String?              @db.Text
  planningDoc     String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assignedPo      String?
  status          String               @default("unreviewed")
  pbEpic          String?
  rejectionReason String?              @db.Text
  freezeReason    String?              @db.Text
  poHearingMemo   String?              @db.Text
  poReviewMemo    String?              @db.Text
  poFlag          String?
  sortOrder       Int                  @default(0)
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version         Int                  @default(0)
  deletedAt       DateTime?
  deletedById     String?
  attachments     IceboxAttachment[]
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  backlogItems    ProductBacklogItem[]

  @@unique([projectId, displayId])
  @@index([projectId])
  @@index([projectId, deletedAt])
  @@index([request(ops: raw("gin_trgm_ops"))], type: Gin, map: "IceboxItem_request_trgm_idx")
  @@index([background(ops: raw("gin_trgm_ops"))], type: Gin, map: "IceboxItem_background_trgm_idx")
  @@index([pbEpic(ops: raw("gin_trgm_ops"))], type: Gin, map: "IceboxItem_pbEpic_trgm_idx")
}

model IceboxAttachment {
  id           String     @id @default(cuid())
  iceboxItemId String
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  createdAt    DateTime   @default(now())
  iceboxItem   IceboxItem @relation(fields: [iceboxItemId], references: [id], onDelete: Cascade)

  @@index([iceboxItemId])
}

model ProductBacklogItem {
  id                 String                  @id @default(cuid())
  projectId          String
  displayId          Int
  iceboxItemId       String?
  initiative         String?
  epic               String?
  userStory          String?                 @db.Text
  acceptanceCriteria String?                 @db.Text
  referenceDoc       String?                 @db.Text
  workloadScore      Int                     @default(0)
  completedAt        DateTime?
  assignedPo         String?
  poNote             String?                 @db.Text
  status             String                  @default("not_ready")
  notReadyReason     String?                 @db.Text
  sortOrder          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  productGoalId      String?
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version            Int                     @default(0)
  deletedAt          DateTime?
  deletedById        String?
  /// Master-plan leaf this PBI contributes to (at most one).
  planItemId         String?
  /// 機密 (decision D-5): never returned to the Claude-facing MCP or the /api/v1 dev API; the signed-in web UI still shows it.
  confidential       Boolean                 @default(false)
  iceboxItem         IceboxItem?             @relation(fields: [iceboxItemId], references: [id])
  planItem           PlanItem?               @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  productGoal        ProductGoal?            @relation(fields: [productGoalId], references: [id])
  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseItems       ReleaseBacklogItem[]
  sprintItems        SprintBacklogItem[]
  /// Finish-to-start links: PBIs that must be completed before this one ("blocked by").
  predecessorDeps    BacklogItemDependency[] @relation("PbiDependencySuccessor")
  /// PBIs waiting for this one.
  successorDeps      BacklogItemDependency[] @relation("PbiDependencyPredecessor")
  /// Files / images of the 参考資料 (reference material) section.
  attachments        PbiAttachment[]
  /// GitLab merge requests / branches / commits naming this PBI (PBI-<displayId>).
  gitLinks           GitLink[]
  /// Who is working on this PBI (or one of its tasks) right now (作業の宣言, dev:write).
  workClaims         WorkClaim[]
  /// 受入基準 as items with stable ids PBI-<displayId>/AC-<seq> (W5). Replaces the free-text
  /// `acceptanceCriteria` above, which stays readable (deprecated) until every consumer moved.
  criteria           AcceptanceCriterion[]

  @@unique([projectId, displayId])
  @@index([projectId])
  @@index([projectId, deletedAt])
  @@index([iceboxItemId])
  @@index([productGoalId])
  @@index([planItemId])
  @@index([initiative(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductBacklogItem_initiative_trgm_idx")
  @@index([epic(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductBacklogItem_epic_trgm_idx")
  @@index([userStory(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductBacklogItem_userStory_trgm_idx")
  @@index([acceptanceCriteria(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductBacklogItem_acceptanceCriteria_trgm_idx")
}

/// One acceptance criterion of a PBI (W5). Display id `PBI-<n>/AC-<seq>`: `seq` counts up per
/// PBI and is never reused (a soft-deleted row keeps its seq; the PBI row lock serializes
/// allocation, the unique index is the backstop). Given / When / Then are optional; `text`
/// is the free-text form (a criterion needs at least one of the four). `evidenceKind`
/// (W12): test | inspection | measurement | approval — how it is proven; null = not decided.
model AcceptanceCriterion {
  id           String             @id @default(cuid())
  pbiId        String
  seq          Int
  given        String?            @db.Text
  when         String?            @db.Text
  then         String?            @db.Text
  text         String?            @db.Text
  evidenceKind String?            @db.VarChar(16)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?
  deletedById  String?
  pbi          ProductBacklogItem @relation(fields: [pbiId], references: [id], onDelete: Cascade)

  @@unique([pbiId, seq])
  @@index([pbiId, deletedAt])
  @@map("acceptance_criterion")
}

/// File or image attached to a PBI's 参考資料 (reference material); stored
/// like the IceBox attachments (private/uploads/<projectId>/<fileName>).
model PbiAttachment {
  id            String             @id @default(cuid())
  backlogItemId String
  fileName      String
  originalName  String
  fileSize      Int
  mimeType      String
  createdAt     DateTime           @default(now())
  backlogItem   ProductBacklogItem @relation(fields: [backlogItemId], references: [id], onDelete: Cascade)

  @@index([backlogItemId])
  @@map("pbi_attachment")
}

/// Finish-to-start dependency between two PBIs of one project: the
/// predecessor must be completed before the successor can start. Advisory:
/// shown on the backlog / sprint pickers, nothing is blocked server-side.
model BacklogItemDependency {
  id            String   @id @default(cuid())
  projectId     String
  predecessorId String
  successorId   String
  createdAt     DateTime @default(now())

  predecessor ProductBacklogItem @relation("PbiDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ProductBacklogItem @relation("PbiDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([successorId])
  @@index([projectId])
}

/// When a user last confirmed a project's updates ("すべて確認済みにする").
/// Activity by others after lastSeenAt counts as new for that user.
model ProjectVisit {
  id         String   @id @default(cuid())
  userId     String
  projectId  String
  lastSeenAt DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

/// Project-wide team chat. A row is either a chat message (body set) or the
/// mirror of a PBI / sprint-task / IceBox comment (commentId set, body NULL:
/// the text is read from the comment so edits and deletes follow). A reply
/// to a mirrored comment is also posted to that comment's thread; the reply
/// row then keeps its own body and links the comment it created.
model TeamMessage {
  id          String                  @id @default(cuid())
  projectId   String
  authorId    String
  body        String?                 @db.Text
  commentId   String?                 @unique
  replyToId   String?
  createdAt   DateTime                @default(now())
  deletedAt   DateTime?
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User                    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  comment     Comment?                @relation(fields: [commentId], references: [id], onDelete: Cascade)
  replyTo     TeamMessage?            @relation("TeamMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     TeamMessage[]           @relation("TeamMessageReply")
  attachments TeamMessageAttachment[]
  mentions    TeamMessageMention[]

  @@index([projectId, createdAt])
  @@index([replyToId])
}

/// A file attached to a team chat message (stored like project attachments).
model TeamMessageAttachment {
  id           String      @id @default(cuid())
  messageId    String
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  createdAt    DateTime    @default(now())
  message      TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model TeamMessageMention {
  messageId String
  userId    String
  message   TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

/// When a user last read a project's team chat (unread = newer messages by others).
model TeamChatRead {
  id         String   @id @default(cuid())
  userId     String
  projectId  String
  lastReadAt DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model Sprint {
  id                   String              @id @default(cuid())
  projectId            String
  sprintName           String
  startDate            DateTime
  endDate              DateTime
  sprintGoal           String?             @db.Text
  capacity             Int                 @default(0)
  actualScore          Int                 @default(0)
  status               String              @default("planning")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  retrospectiveMemo    String?             @db.Text
  retrospectiveKeep    String?             @db.Text
  retrospectiveProblem String?             @db.Text
  retrospectiveTry     String?             @db.Text
  reviewComment        String?             @db.Text
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version              Int                 @default(0)
  calendarEvents       CalendarEvent[]
  dailyScrumNotes      DailyScrumNote[]
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items                SprintBacklogItem[]

  @@index([projectId])
}

model DailyScrumNote {
  id         String    @id @default(cuid())
  sprintId   String
  date       DateTime
  content    String    @db.Text
  author     String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sprint     Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId])
  @@index([sprintId, date])
  @@index([archivedAt])
}

model SprintBacklogItem {
  id                String              @id @default(cuid())
  sprintId          String
  pbItemId          String
  taskName          String?
  assignee          String?
  estimatedHours    Float?
  actualHours       Float?
  status            String              @default("todo")
  completedAt       DateTime?
  completionComment String?             @db.Text
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version           Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  pbItem            ProductBacklogItem  @relation(fields: [pbItemId], references: [id], onDelete: Cascade)
  sprint            Sprint              @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  /// Normalized assignees (P2). The legacy `assignee` string (comma-separated
  /// names) stays during the transition; backfilled by scripts/migrate-assignees.ts.
  assignees         TaskAssignee[]
  /// Carry-over: the task of an earlier sprint this one was copied from. The
  /// original stays as that sprint's record; once it has a copy it no longer
  /// counts against its PBI and is not offered for carry-over again.
  carriedFromId     String?
  carriedFrom       SprintBacklogItem?  @relation("TaskCarryOver", fields: [carriedFromId], references: [id], onDelete: SetNull)
  carriedCopies     SprintBacklogItem[] @relation("TaskCarryOver")
  workClaims        WorkClaim[]

  @@index([sprintId])
  @@index([pbItemId])
  @@index([carriedFromId])
  @@index([taskName(ops: raw("gin_trgm_ops"))], type: Gin, map: "SprintBacklogItem_taskName_trgm_idx")
}

model ReleaseBacklogItem {
  id              String               @id @default(cuid())
  projectId       String
  planVersion     String?
  pbItemId        String?
  iceboxId        String?
  initiative      String?
  epic            String?
  userStory       String?              @db.Text
  assignedPo      String?
  releaseVersion  String?
  releaseDate     DateTime?
  releaseNote     String?              @db.Text
  manualLink      String?              @db.Text
  poNote          String?              @db.Text
  status          String               @default("staged")
  /// 改善成果ボード (process_improvement projects only; the software screen ignores these).
  /// time | quality | cost | safety | other
  metricCategory  String?              @db.VarChar(20)
  metricName      String?              @db.VarChar(200)
  metricUnit      String?              @db.VarChar(20)
  /// Which way is better: "decrease" | "increase".
  direction       String               @default("decrease") @db.VarChar(10)
  baselineValue   Float?
  targetValue     Float?
  resultValue     Float?
  /// Legacy (yen, before the switch to USD): kept for the record, no longer shown or written.
  annualEffectYen Int?
  /// 効果金額 in whole US dollars per year.
  annualEffectUsd Int?
  /// スペース削減 in m² (area only for now; a money conversion is planned).
  spaceSavedM2    Float?
  /// measuring | standardized | deploying | sustained | deferred
  kaizenStage     String               @default("measuring") @db.VarChar(20)
  standardizedAt  DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  pbItem          ProductBacklogItem?  @relation(fields: [pbItemId], references: [id], onDelete: SetNull)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rollouts        ImprovementRollout[]
  checks          ImprovementCheck[]
  photos          ImprovementPhoto[]

  @@index([projectId])
  @@index([pbItemId])
}

/// 横展開先 of an improvement (another line / plant the kaizen is copied to).
model ImprovementRollout {
  id            String             @id @default(cuid())
  releaseItemId String
  targetName    String             @db.VarChar(200)
  /// todo | doing | done
  status        String             @default("todo") @db.VarChar(10)
  doneAt        DateTime?
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  releaseItem   ReleaseBacklogItem @relation(fields: [releaseItemId], references: [id], onDelete: Cascade)

  @@index([releaseItemId, sortOrder])
  @@map("improvement_rollout")
}

/// 定着確認 (sustainment check) of an improvement, e.g. 1 and 3 months after 展開日.
model ImprovementCheck {
  id            String             @id @default(cuid())
  releaseItemId String
  dueDate       DateTime
  /// 1m | 3m | custom
  kind          String             @db.VarChar(10)
  checkedAt     DateTime?
  /// sustained | regressed | null (not checked yet)
  result        String?            @db.VarChar(10)
  note          String?            @db.Text
  checkedById   String?
  checkedByName String?
  /// Set once the PO reminder for a due check was sent (worker collab-daily).
  notifiedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  releaseItem   ReleaseBacklogItem @relation(fields: [releaseItemId], references: [id], onDelete: Cascade)

  @@index([releaseItemId])
  @@index([dueDate, checkedAt, notifiedAt])
  @@map("improvement_check")
}

/// Before / after photos of an improvement (stored like PbiAttachment).
model ImprovementPhoto {
  id            String             @id @default(cuid())
  releaseItemId String
  /// before | after
  phase         String             @db.VarChar(10)
  fileName      String
  originalName  String
  fileSize      Int
  mimeType      String
  createdAt     DateTime           @default(now())
  releaseItem   ReleaseBacklogItem @relation(fields: [releaseItemId], references: [id], onDelete: Cascade)

  @@index([releaseItemId, phase])
  @@map("improvement_photo")
}

model CalendarEvent {
  id          String    @id @default(cuid())
  projectId   String
  sprintId    String?
  title       String
  description String?   @db.Text
  date        DateTime
  endDate     DateTime?
  color       String    @default("blue")
  allDay      Boolean   @default(true)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sprintId])
}

model AttachmentFolder {
  id          String              @id @default(cuid())
  projectId   String
  parentId    String?
  name        String
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      AttachmentFolder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    AttachmentFolder[]  @relation("FolderTree")
  attachments ProjectAttachment[]

  @@index([projectId])
  @@index([parentId])
}

model ProjectAttachment {
  id           String            @id @default(cuid())
  projectId    String
  folderId     String?
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  uploadedBy   String?
  /// Set for a link entry (e.g. a GitLab repository): no stored file, the row opens this http(s) URL.
  linkUrl      String?           @db.VarChar(2048)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  folder       AttachmentFolder? @relation(fields: [folderId], references: [id])
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([folderId])
  @@index([folderId, sortOrder])
}

model UserProjectCategory {
  id          String                          @id @default(cuid())
  userId      String
  /// citext: unique per user regardless of case (MySQL utf8mb4_unicode_ci parity).
  name        String                          @db.Citext
  color       String                          @default("gray")
  sortOrder   Int                             @default(0)
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt
  user        User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments UserProjectCategoryAssignment[]

  @@unique([userId, name])
  @@index([userId])
}

model UserProjectCategoryAssignment {
  id         String              @id @default(cuid())
  categoryId String
  projectId  String
  category   UserProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([categoryId, projectId])
  @@index([categoryId])
  @@index([projectId])
}

/// Both-language storage for user-entered free text (src/lib/translation).
/// One row per (entity, field). The row doubles as the background-translation
/// queue: status / priority / attempts live here, there is no separate queue.
/// The source-locale column holds the original text verbatim; the other side
/// is filled by the background worker (or by the legacy bilingual-pair split).
model FieldTranslation {
  entityType   String    @map("entity_type") @db.VarChar(64)
  entityId     String    @map("entity_id") @db.VarChar(191)
  field        String    @db.VarChar(64)
  sourceLocale String    @map("source_locale") @db.Char(2)
  sourceHash   String    @map("source_hash") @db.VarChar(64)
  textJa       String?   @map("text_ja") @db.Text
  textId       String?   @map("text_id") @db.Text
  /// English side (added 2026-10; NULL on older rows until the worker fills it).
  textEn       String?   @map("text_en") @db.Text
  status       String    @default("pending") @db.VarChar(16)
  priority     Int       @default(0)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error") @db.Text
  model        String?   @db.VarChar(128)
  requestedAt  DateTime  @default(now()) @map("requested_at")
  startedAt    DateTime? @map("started_at")
  translatedAt DateTime? @map("translated_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@id([entityType, entityId, field])
  @@index([status, priority(sort: Desc), requestedAt])
  /// The worker's English-backfill claim (claimEnglishBackfill): only rows still waiting for their English side.
  /// The predicate is written in PostgreSQL's normalized form (pg_get_expr) so the drift check compares equal.
  @@index([priority(sort: Desc), updatedAt(sort: Desc)], map: "field_translation_en_backfill_idx", where: raw("((status)::text = 'done'::text) AND (text_en IS NULL) AND (source_locale = ANY (ARRAY['ja'::bpchar, 'id'::bpchar]))"))
  @@index([textJa(ops: raw("gin_trgm_ops"))], type: Gin, map: "field_translation_text_ja_trgm_idx")
  @@index([textId(ops: raw("gin_trgm_ops"))], type: Gin, map: "field_translation_text_id_trgm_idx")
  @@map("field_translation")
}

/// Shared translation glossary: a correction by one user is applied to every
/// later translation. Registered from `用語<<訳語>>` markup in any text input
/// or from /admin/glossary. (source, target, term_norm) is unique; the reverse
/// direction is auto-registered (auto_reverse=true) until edited by hand.
model Glossary {
  id           String   @id @default(cuid())
  sourceLocale String   @map("source_locale") @db.Char(2)
  targetLocale String   @map("target_locale") @db.Char(2)
  term         String   @db.VarChar(255)
  termNorm     String   @map("term_norm") @db.VarChar(255)
  translation  String   @db.VarChar(500)
  note         String?  @db.Text
  autoReverse  Boolean  @default(false) @map("auto_reverse")
  usageCount   Int      @default(0) @map("usage_count")
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([sourceLocale, targetLocale, termNorm])
  @@index([sourceLocale, targetLocale])
  @@map("glossary")
}

// ---------------------------------------------------------------------------
// P2 collaboration foundation (migration 20261002000000_p2_collab_foundation)
// Table/column naming follows the core models (PascalCase table = model name,
// camelCase columns, cuid ids), not the snake_case translation tables.
// ---------------------------------------------------------------------------

/// Audit / change history. One row per mutation of a tracked entity.
/// entityType: project | pbi | sprint | sprint_task | icebox | comment | ...
/// action: create | update | delete | restore | status_change | ...
/// actorName is denormalized so history stays readable if the actor is gone.
/// diff is a JSON string ({ field: [before, after] }) — Text, like the other
/// JSON-in-Text columns (AiReport.structured / meta).
model ActivityLog {
  id         String   @id @default(cuid())
  projectId  String
  entityType String   @db.VarChar(32)
  entityId   String   @db.VarChar(191)
  action     String   @db.VarChar(32)
  actorId    String?
  actorName  String?
  diff       String?  @db.Text
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

/// In-app notification (bell). payload is a JSON string rendered client-side.
/// dedupeKey (e.g. "due_soon:<taskId>:2026-10-02") makes scheduled jobs
/// idempotent: a repeat insert with the same (recipientId, dedupeKey) fails
/// with P2002 and is skipped. NULL keys never collide (MySQL unique semantics),
/// so ad-hoc notifications simply leave it null.
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  type        String    @db.VarChar(32)
  entityType  String?   @db.VarChar(32)
  entityId    String?   @db.VarChar(191)
  projectId   String?
  payload     String?   @db.Text
  dedupeKey   String?   @db.VarChar(191)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt])
  @@index([projectId])
}

/// Per-user opt-out per notification type. Missing row = enabled.
model NotificationPreference {
  userId  String
  type    String  @db.VarChar(32)
  enabled Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

/// Comment thread on a PBI / sprint task / icebox request (polymorphic:
/// entityType = pbi | sprint_task | icebox, entityId = that row's id).
/// Soft-deleted comments keep their row (deletedAt) so thread order and
/// mentions stay intact. author is Restrict: users are deactivated, never
/// deleted, and a comment must not silently vanish with its author.
model Comment {
  id         String           @id @default(cuid())
  projectId  String
  entityType String           @db.VarChar(32)
  entityId   String           @db.VarChar(191)
  authorId   String
  body       String           @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  editedAt   DateTime?
  deletedAt  DateTime?
  /// "api" (REST /api/v1) | "mcp" (Kanflow MCP, AI) when posted with an access token; null = the UI.
  via        String?          @db.VarChar(8)
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  mentions   CommentMention[]

  teamMessage TeamMessage?

  @@index([entityType, entityId, createdAt])
  @@index([projectId, createdAt])
  @@index([authorId])
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "Comment_body_trgm_idx")
}

/// @mentions parsed from Comment.body (drives mention notifications).
model CommentMention {
  commentId String
  userId    String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

/// Normalized sprint-task assignee (replaces the comma-separated
/// SprintBacklogItem.assignee string; backfill: scripts/migrate-assignees.ts).
model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime          @default(now())
  task      SprintBacklogItem @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// P3 AI extensions (migration 20261003000000_p3_ai)
// ---------------------------------------------------------------------------

/// Persisted project chat conversation. Private to its owner (userId):
/// nobody else — system admins included — can list or read it. Soft delete
/// (deletedAt); the worker purges deleted threads after 30 days and every
/// thread idle longer than CHAT_RETENTION_DAYS (default 180).
model ChatThread {
  id        String        @id @default(cuid())
  projectId String
  userId    String
  title     String        @db.VarChar(200)
  createdAt DateTime      @default(now())
  /// Last activity (bumped on every stored message); the list is ordered by it.
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([projectId, userId, deletedAt, updatedAt])
  @@index([deletedAt])
  @@index([updatedAt])
}

/// One stored chat turn. role: user | assistant. toolEvents is a JSON string
/// (tool calls, proposals) — Text like the other JSON-in-Text columns.
/// partial = the answer was cut short (stopped by the user, error, timeout).
model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  role       String     @db.VarChar(16)
  content    String     @db.Text
  toolEvents String?    @db.Text
  partial    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Queue of long-running AI generations (progress report, sprint review).
/// Run by the worker (AI_TRANSLATION_WORKER=external) or inside the web
/// process (inprocess). status: queued | running | done | failed | cancelled.
/// activeKey = "<projectId>:<kind>[:<scope>]" while queued/running and NULL
/// afterwards: the unique index allows one active job per project + kind.
/// params is a JSON string. resultReportId is a plain AiReport id (no FK:
/// reports are pruned by retention independently).
model AiJob {
  id             String    @id @default(cuid())
  projectId      String
  userId         String?
  kind           String    @db.VarChar(32)
  params         String?   @db.Text
  status         String    @default("queued") @db.VarChar(16)
  progress       Int?
  attempts       Int       @default(0)
  activeKey      String?   @unique @db.VarChar(191)
  resultReportId String?
  error          String?   @db.Text
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// P4 personal access tokens + metrics (migration 20261005000000_api_tokens_metrics)
// ---------------------------------------------------------------------------

/// Personal access token for the read-only REST API (/api/v1). Only the
/// SHA-256 hex of the token is stored (tokenHash, unique → constant-time
/// lookup by index); the plain token ("kfl_" + 32 random bytes base64url) is
/// shown once at creation. prefix = the first 12 chars ("kfl_" + 8) for display.
/// scopes is a JSON array string (only "read" today). userTokenVersion copies
/// User.tokenVersion at creation: a later bump (deactivate / role change /
/// password reset) invalidates the token even if the revoke hook missed it.
model ApiToken {
  id               String    @id @default(cuid())
  userId           String
  name             String    @db.VarChar(100)
  tokenHash        String    @unique @db.Char(64)
  prefix           String    @db.VarChar(16)
  scopes           String    @db.VarChar(191)
  /// JSON array of project ids the token is limited to; null = every project the owner can access.
  projectIds       String?   @db.Text
  userTokenVersion Int       @default(0)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([createdAt])
}

/// Periodic snapshot of the in-process request / AI / queue metrics (web
/// process timer, every 5 min). data is a JSON string (Text like the other
/// JSON-in-Text columns). Pruned after METRICS_RETENTION_DAYS (default 14).
model MetricSnapshot {
  id      String   @id @default(cuid())
  takenAt DateTime @default(now())
  data    String   @db.Text

  @@index([takenAt])
}

/// Per-project GitLab integration switch and access token. A project without
/// a row (or enabled = false) shows no Git UI at all — Kanflow is also used by
/// process-improvement teams that never touch Git.
/// One per project (primary key projectId): a project reads exactly ONE source,
/// never GitLab and GitStation side by side (both would show every MR / commit twice).
model GitIntegration {
  projectId           String   @id
  enabled             Boolean  @default(false)
  /// Where the project's development data is read from (services/git/git-provider):
  /// "gitlab" (polled REST v4) or "gitstation" (the integration event feed, M3 K3).
  /// Validated by the settings API and the source factory; cannot change while repositories exist.
  provider            String   @default("gitlab") @db.VarChar(32)
  /// provider "gitstation": GitStation's integration id (opaque, plan 02 §5.7). The feed of
  /// that integration is read once per poll for every project using it (git_station_feed).
  stationIntegrationId String? @db.VarChar(64)
  /// Access token (group or project token, read_api), AES-256-GCM sealed by lib/secret-box. Never returned by the API.
  tokenCipher         String?  @db.Text
  /// Last 4 characters, shown as "••••abcd" so people can tell which token is set.
  tokenHint           String?  @db.VarChar(8)
  /// When every merge request of a PBI is merged, its in-progress tasks of the active sprint become done.
  autoCompleteOnMerge Boolean  @default(false)
  /// provider "gitstation": Kanflow reports the check `kanflow/acceptance` on the head commit of every open merge
  /// request linked to PBIs (services/git/acceptance-check.service). A report only: whether the check is required
  /// for a merge is GitStation's setting. Off by default.
  stationAcceptanceCheck Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("git_integration")
}

/// The GitStation event feed of one integration as one service-account token sees it
/// (services/git/gitstation-feed-sync): ONE opaque cursor per (GitStation, integration, token),
/// read once per poll and dispatched to every Kanflow repository it covers. Different tokens
/// get different rows (their visibility may differ). Holds no secret: only a SHA-256 prefix of
/// the token identifies it.
model GitStationFeed {
  id               String    @id @default(cuid())
  /// https://host of GitStation (the repositories' apiBase).
  apiBase          String    @db.VarChar(255)
  integrationId    String    @db.VarChar(64)
  /// First 32 hex characters of SHA-256(token).
  tokenFingerprint String    @db.VarChar(32)
  /// "gitstation:v1:<GitStation cursor>"; null = not read yet / restarted (re-read the state first).
  cursor           String?   @db.Text
  /// Bumped by 過去分を再同期: a read that started under an older generation does not write its cursor.
  generation       Int       @default(0)
  /// Lease of the read in progress (one reader per feed: the poller and 今すぐ同期 never overlap).
  leaseOwner       String?   @db.VarChar(36)
  leaseUntil       DateTime?
  /// Consecutive reads that held the cursor (the log escalates after 3).
  consecutiveHolds Int       @default(0)
  readAt           DateTime?
  lastError        String?   @db.VarChar(500)
  lastErrorAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([apiBase, integrationId, tokenFingerprint])
  @@map("git_station_feed")
}

/// One GitLab repository of a project (a project may have several: front end,
/// API, edge ...). Polled by lib/git/poller (GitLab cannot reach the LAN, so no webhooks).
model GitRepository {
  id                String       @id @default(cuid())
  projectId         String
  /// Display name ("API", "フロント").
  name              String       @db.VarChar(100)
  /// https://host/group/repo as entered (normalised, no .git).
  webUrl            String       @db.VarChar(1024)
  /// https://host — the API base.
  apiBase           String       @db.VarChar(255)
  /// group/sub/repo
  repoPath          String       @db.VarChar(512)
  /// GitLab numeric project id (resolved on the connection test).
  externalId        Int?
  /// Optional per-repository token (overrides the integration token).
  tokenCipher       String?      @db.Text
  tokenHint         String?      @db.VarChar(8)
  /// Last successful sync.
  syncedAt          DateTime?
  /// DEPRECATED (one release): the old single watermark. Still written (earlier of the
  /// two cursors below) so a rollback keeps working; read only as a fallback.
  syncCursor        DateTime?
  /// Merge request cursor (GitLab time): every MR updated before mrCursorAt was read,
  /// plus the first mrCursorSeen (GitLab order) updated exactly at mrCursorAt (tie-breaker).
  mrCursorAt        DateTime?
  mrCursorSeen      Int?
  /// Commit cursor: the next commit window starts at commitCursorAt and is
  /// commitWindowSec wide (shrinks when cut off, grows when not); commitSkips =
  /// consecutive windows skipped because even the smallest window was cut off.
  commitCursorAt    DateTime?
  commitWindowSec   Int?
  commitSkips       Int?
  /// Look-back re-read of older commits (late pushes; 過去分を再同期): position and window
  /// of a pass in progress (null = none), and when the last pass started.
  lookbackCursorAt  DateTime?
  lookbackWindowSec Int?
  lookbackAt        DateTime?
  /// Bumped by 過去分を再同期: a sync writes its cursors only while the generation it
  /// started with is unchanged, so a sync already running cannot undo a resync.
  syncGeneration    Int?         @default(0)
  /// GitStation: this repository's merge requests must be re-read from GitStation's state
  /// (not bound for a while, its state re-read failed, …) — set since then; cleared once re-read.
  stationRereadAt   DateTime?
  /// GitStation: consecutive failed state re-reads of this repository (shown in the log).
  stationRereadFailures Int        @default(0)
  /// GitStation: no state re-read before this time (exponential back-off after failed re-reads).
  stationRereadNextAt   DateTime?
  /// GitStation: consecutive reads in which this repository could not be written (quarantined at 3).
  stationWriteFailures  Int        @default(0)
  lastError         String?      @db.VarChar(500)
  lastErrorAt       DateTime?
  sortOrder         Int          @default(0)
  /// "AI の参照資料として使う": the repository's documents / code are indexed
  /// into repo_chunk and searchable by the project AI chat (PO / SM switch).
  aiKnowledge       Boolean      @default(false)
  /// Optional folder prefixes to index (comma / newline separated, e.g. "docs/"); null = whole repository.
  aiPathFilter      String?      @db.VarChar(1000)
  /// Commit the index reflects, when it was completed and how many files it holds.
  indexedSha        String?      @db.VarChar(64)
  indexedAt         DateTime?
  indexedFiles      Int          @default(0)
  /// A pass in progress (resumed on the next poller tick): target commit and last finished path.
  indexTargetSha    String?      @db.VarChar(64)
  indexCursor       String?      @db.VarChar(512)
  indexError        String?      @db.VarChar(500)
  indexErrorAt      DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links             GitLink[]
  releases          GitRelease[]
  chunks            RepoChunk[]
  acceptanceReports GitAcceptanceReport[]

  @@index([projectId])
  @@map("git_repository")
}

/// What Kanflow last reported to GitStation as the check `kanflow/acceptance` of one merge request
/// (services/git/acceptance-check.service). One row per (repository, merge request): the same result on the same
/// head commit is not sent again, and a failed read / report waits until `retryAt`. The row holds no PBI text —
/// only the commit id, the conclusion and a digest of what was sent.
model GitAcceptanceReport {
  id            String        @id @default(cuid())
  repositoryId  String
  /// Merge request iid (git_link.ref of the "mr" links).
  mrRef         String        @db.VarChar(255)
  /// The links' latest occurredAt when the head commit was last read: a later one means the merge request changed.
  mrSeenAt      DateTime?
  /// When the head commit was last read from GitStation (read again after a while even without a change signal).
  headCheckedAt DateTime?
  /// Head commit the last report was written on (lowercase hex, 40 or 64 characters); null = nothing reported yet.
  headSha       String?       @db.VarChar(64)
  /// Conclusion last reported: "success" | "action_required".
  conclusion    String?       @db.VarChar(24)
  /// SHA-256 (hex) of the conclusion and the summary last reported.
  digest        String?       @db.VarChar(64)
  reportedAt    DateTime?
  /// The last failed read / report (Japanese, translated in the settings screen); cleared by the next success.
  lastError     String?       @db.VarChar(500)
  lastErrorAt   DateTime?
  /// Not tried again before this time (a refusal that does not go away by itself waits longer).
  retryAt       DateTime?
  /// Consecutive failed reads / reports (0 after a success): the wait before the next try grows with it.
  failures      Int           @default(0)
  /// The last failure holds for the whole repository (report refused, repository not readable): until `retryAt`
  /// none of the repository's merge requests is tried.
  repositoryWide Boolean      @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  repository    GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, mrRef])
  @@map("git_acceptance_report")
}

/// One searchable passage of a knowledge repository file (services/git/repo-index):
/// a Markdown section or a ~2,000-character window. FULLTEXT ngram index
/// ft_repo_chunk_text (migration 20261016000000_repo_knowledge).
model RepoChunk {
  id           String        @id @default(cuid())
  repositoryId String
  projectId    String
  /// File path inside the repository.
  path         String        @db.VarChar(512)
  /// Heading path ("06 OEE > 2.3 定義") for citations; null for plain windows.
  heading      String?       @db.VarChar(500)
  /// GitLab URL fragment: Markdown heading slug, or "L12" for text / code; null for Office / PDF.
  anchor       String?       @db.VarChar(255)
  chunkNo      Int
  content      String        @db.Text
  /// Git blob id of the file version this chunk came from.
  blobSha      String        @db.VarChar(64)
  createdAt    DateTime      @default(now())
  repository   GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([repositoryId, path, chunkNo])
  @@index([projectId])
  @@index([path(ops: raw("gin_trgm_ops"))], type: Gin, map: "repo_chunk_path_trgm_idx")
  @@index([heading(ops: raw("gin_trgm_ops"))], type: Gin, map: "repo_chunk_heading_trgm_idx")
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "repo_chunk_content_trgm_idx")
  @@map("repo_chunk")
}

/// A merge request, branch or commit that names a PBI (PBI-123 in its title,
/// branch name or message). One row per (repository, object, PBI).
model GitLink {
  id                String             @id @default(cuid())
  projectId         String
  repositoryId      String
  backlogItemId     String
  /// "mr" | "branch" | "commit"
  kind              String             @db.VarChar(16)
  /// MR iid, branch name or commit sha.
  ref               String             @db.VarChar(255)
  title             String             @db.VarChar(500)
  url               String             @db.VarChar(1024)
  /// MR: opened | merged | closed | locked; null for branches / commits.
  state             String?            @db.VarChar(16)
  /// Latest pipeline status (MR head pipeline / branch / commit), when known.
  pipeline          String?            @db.VarChar(24)
  author            String?            @db.VarChar(191)
  sourceBranch      String?            @db.VarChar(255)
  /// When it last changed on GitLab (MR updated_at, commit date, branch head date).
  occurredAt        DateTime
  mergedAt          DateTime?
  /// MR links only (plan 12 E1): when the MR was opened (GitLab created_at / GitStation opened_at); null = unknown.
  openedAt          DateTime?
  /// MR links only (N11 マージの履歴): the branch the MR merges into; null = the source did not say.
  targetBranch      String?            @db.VarChar(255)
  /// MR links only (N11): display name of who merged it, as the source reported (GitStation: the actor of the
  /// merged event; GitLab: merge_user). Null = unknown (merged before this was recorded, or merged by the system).
  mergedBy          String?            @db.VarChar(191)
  /// MR links only (N2): the commit at the head of the MR's source branch as last read (40 or 64 lower-case hex);
  /// null = not read yet. GitStation's check.completed names a commit only: this finds its merge request.
  headSha           String?            @db.VarChar(64)
  /// MR links only (plan 12 E1, filled once GitStation G1 reports them): number of versions, lines added / removed.
  /// Null = not reported (never 0 for unknown).
  versionCount      Int?
  additions         Int?
  deletions         Int?
  /// Branch links only: when the branch was no longer in GitLab's (complete) branch list.
  /// Kept (shown as 削除済み on the PBI) instead of deleted; cleared if the branch comes back.
  goneAt            DateTime?
  /// Declared by a developer (dev:write, POST /api/v1/.../dev/mr-links) rather than found by the
  /// sync; null = found by the sync. The sync keeps refreshing state / title of a declared MR.
  declaredById      String?
  declaredAt        DateTime?
  /// MR links only (W4 触る範囲): when the sync last compared the MR's changed files with the
  /// declared scope of the PBI's active work claims; null = never compared (no scope declared).
  scopeCheckedAt    DateTime?
  /// How many changed files lay outside the declared scope at that check (0 = all inside).
  outsideScopeCount Int?
  /// The first of those files (JSON array of strings, at most 20) for the PBI panel.
  outsideScopePaths Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository        GitRepository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  backlogItem       ProductBacklogItem @relation(fields: [backlogItemId], references: [id], onDelete: Cascade)
  declaredBy        User?              @relation("GitLinkDeclaredBy", fields: [declaredById], references: [id], onDelete: SetNull)
  approvalAttempts  GitMrApprovalAttempt[]

  @@unique([repositoryId, kind, ref, backlogItemId])
  @@index([backlogItemId])
  @@index([projectId, occurredAt])
  /// N11 マージの履歴: merged MRs of a project, newest first.
  @@index([projectId, mergedAt])
  /// N2: the merge request whose head a check ran on.
  @@index([repositoryId, headSha])
  @@index([declaredById])
  @@map("git_link")
}

/// 作業の宣言 (work claim, K5): a developer's AI session declares it is working on a PBI
/// (taskId null) or one of its sprint tasks, from which session and on which branch
/// (services/dev-work, docs/api-v1.md "Development (dev:write)"). Active = not released and
/// heartbeatAt within the stale window (DEV_CLAIM_STALE_HOURS); stale rows are kept as history.
model WorkClaim {
  id            String             @id @default(cuid())
  projectId     String
  backlogItemId String
  /// null = the claim covers the whole PBI.
  taskId        String?
  /// The token owner who claimed (created by).
  userId        String
  /// Client-chosen session id (e.g. the Claude Code session), 1-100 visible ASCII characters.
  sessionId     String             @db.VarChar(100)
  branch        String?            @db.VarChar(255)
  heartbeatAt   DateTime
  releasedAt    DateTime?
  /// Why it ended: "released" (owner) | "takeover" (owner's other session) |
  /// "stale" (superseded by a new claim after the stale window) | "moderator" (PO / SM / admin).
  releaseReason String?            @db.VarChar(16)
  /// Who ended it when not the owner (moderator / the user whose claim superseded it).
  releasedById  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  backlogItem   ProductBacklogItem @relation(fields: [backlogItemId], references: [id], onDelete: Cascade)
  task          SprintBacklogItem? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes        WorkClaimScope[]

  @@index([projectId, releasedAt, heartbeatAt])
  @@index([backlogItemId, releasedAt])
  @@index([taskId])
  @@index([userId, sessionId])
  @@map("work_claim")
}

/// 触る範囲 (touched scope, W4) of a work claim: the files / modules the session declared it
/// will touch (services/dev-work/dev-work.scope). Replaced as a whole by PUT .../dev/claims/:id/scope
/// (at most 200 per claim). No unique index on value: values are case-sensitive and compared in
/// the service (MySQL's collation is case-insensitive, PostgreSQL's is not).
model WorkClaimScope {
  id        String    @id @default(cuid())
  claimId   String
  /// "path" (relative POSIX file / directory) | "module" (crate / package / directory name).
  kind      String    @db.VarChar(8)
  /// Normalized value (dev-work.scope normalizeScopeValue), at most 300 characters.
  value     String    @db.VarChar(300)
  createdAt DateTime  @default(now())
  claim     WorkClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("work_claim_scope")
}

// ─── マイルストーン・検収ボード (general projects, 2026-10) ────────────────
// The stages ARE the project's top-level PlanItems (name / dates / status /
// 完了条件 notes are read from there, never copied); these tables keep only
// the board's own state. Users are referenced by id + name (no FK).

/// Board settings of a project: the チェック項目 呼び名 and the optional parts.
model MilestoneBoard {
  projectId     String   @id
  /// 呼び名 of the check items (検収 / テスト / 評価 …); null = the UI default.
  checkLabel    String?  @db.VarChar(40)
  budgetEnabled Boolean  @default(false)
  /// 推移 (monthly metric trend) tab shown even before a metric exists.
  trendEnabled  Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("milestone_board")
}

/// Idempotency marker: this template load's checks / documents / flags were
/// copied onto the board (lazily, on the first board read after the load).
model MilestoneBoardSeed {
  applicationId String   @id
  projectId     String
  seededAt      DateTime @default(now())

  application PlanTemplateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestone_board_seed")
}

/// A ticked 完了条件 of a stage. The condition text lives in PlanItem.notes
/// ("完了条件:\n- …"); the row exists only while the condition is ticked.
model MilestoneChecklistState {
  id            String   @id @default(cuid())
  planItemId    String
  /// citext: unique per plan item regardless of case (MySQL utf8mb4_unicode_ci parity).
  label         String   @db.Citext
  checkedById   String?
  checkedByName String?  @db.VarChar(255)
  checkedAt     DateTime @default(now())

  planItem PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)

  @@unique([planItemId, label])
  @@map("milestone_checklist_state")
}

/// チェック項目 (検収 / テスト / 評価 / 竣工検査 …) with its criterion and result.
model AcceptanceCheck {
  id             String    @id @default(cuid())
  projectId      String
  planItemId     String?
  name           String    @db.VarChar(255)
  criterion      String?   @db.Text
  /// passed | conditional | failed | null (not checked yet)
  result         String?   @db.VarChar(16)
  /// 立会者 (free text: customer / maker staff are often not users).
  witness        String?   @db.VarChar(255)
  /// Day of the check (UTC midnight).
  checkedAt      DateTime?
  note           String?   @db.Text
  recordedById   String?
  recordedByName String?   @db.VarChar(255)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planItem PlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  @@index([projectId, sortOrder])
  @@index([planItemId])
  @@map("acceptance_check")
}

/// 残課題 (punch list item).
model PunchItem {
  id            String       @id @default(cuid())
  projectId     String
  planItemId    String?
  title         String       @db.VarChar(255)
  detail        String?      @db.Text
  /// A project member (id + name) or just a name (e.g. the maker's engineer).
  assigneeId    String?
  assigneeName  String?      @db.VarChar(255)
  dueDate       DateTime?
  /// open | in_progress | done
  status        String       @default("open") @db.VarChar(16)
  closedAt      DateTime?
  sortOrder     Int          @default(0)
  createdById   String?
  createdByName String?      @db.VarChar(255)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  photos        PunchPhoto[]

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planItem PlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([planItemId])
  @@map("punch_item")
}

/// Photo of a 残課題 (stored like PbiAttachment, counted in the project quota).
model PunchPhoto {
  id           String    @id @default(cuid())
  punchItemId  String
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  createdAt    DateTime  @default(now())
  punchItem    PunchItem @relation(fields: [punchItemId], references: [id], onDelete: Cascade)

  @@index([punchItemId])
  @@map("punch_photo")
}

/// 引き渡し資料 (a document to be handed over), with received state and files.
model HandoverDocument {
  id             String         @id @default(cuid())
  projectId      String
  name           String         @db.VarChar(255)
  /// pending | received
  status         String         @default("pending") @db.VarChar(16)
  receivedAt     DateTime?
  receivedByName String?        @db.VarChar(255)
  note           String?        @db.Text
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  files          HandoverFile[]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("handover_document")
}

/// A file attached to a 引き渡し資料 (stored like PbiAttachment, counted in the quota).
model HandoverFile {
  id             String           @id @default(cuid())
  documentId     String
  fileName       String
  originalName   String
  fileSize       Int
  mimeType       String
  uploadedByName String?          @db.VarChar(255)
  createdAt      DateTime         @default(now())
  document       HandoverDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("handover_file")
}

/// 予算 line (plan / actual in yen; DOUBLE keeps whole yen exact far past INT).
model BudgetLine {
  id         String   @id @default(cuid())
  projectId  String
  name       String   @db.VarChar(255)
  plannedYen Float?
  actualYen  Float?
  note       String?  @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("budget_line")
}

/// 推移 metric of a long-running project (e.g. 不良率 per month).
model MilestoneMetric {
  id            String                 @id @default(cuid())
  projectId     String
  name          String                 @db.VarChar(200)
  unit          String?                @db.VarChar(20)
  /// decrease | increase (which way is better)
  direction     String                 @default("decrease") @db.VarChar(10)
  baselineValue Float?
  targetValue   Float?
  sortOrder     Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  points        MilestoneMetricPoint[]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("milestone_metric")
}

/// One monthly value of a 推移 metric.
model MilestoneMetricPoint {
  id             String          @id @default(cuid())
  metricId       String
  /// "YYYY-MM"
  month          String          @db.VarChar(7)
  value          Float
  recordedByName String?         @db.VarChar(255)
  updatedAt      DateTime        @updatedAt
  metric         MilestoneMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, month])
  @@map("milestone_metric_point")
}

/// Emoji reaction of one user on a comment-like text (one row per user + emoji).
/// targetType: comment (PBI / task / IceBox comment; a team-chat mirror of it
/// shares these rows) | team_message (a plain chat message) | task_completion
/// (the completion comment of a sprint task). The emoji is one of
/// REACTION_EMOJIS (services/reactions/reactions.schemas.ts). No FK on the
/// target: it lives in different tables, the service validates it and reads
/// ignore rows of removed targets.
model Reaction {
  id         String   @id @default(cuid())
  projectId  String
  targetType String   @db.VarChar(32)
  targetId   String   @db.VarChar(191)
  userId     String
  emoji      String   @db.VarChar(16)
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId, emoji])
  @@index([projectId, targetType, targetId])
  @@map("reaction")
}

/// A tag (and its GitLab release, when one exists) of a project's repository.
/// Matched to the release tab's versions by name ("v1.4.0" = "1.4.0").
model GitRelease {
  id           String        @id @default(cuid())
  projectId    String
  repositoryId String
  /// citext: unique per repository regardless of case, as on MySQL (sync upserts by tag).
  tag          String        @db.Citext
  /// GitLab release title; null for a bare tag.
  name         String?       @db.VarChar(255)
  /// GitLab release description (Markdown); null for a bare tag.
  description  String?       @db.Text
  url          String        @db.VarChar(1024)
  /// Release date on GitLab, else the tagged commit's date.
  releasedAt   DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository   GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, tag])
  @@index([projectId, releasedAt])
  @@map("git_release")
}

/// フィードバックの輪 (W11, services/feedback; docs/api-v1.md "Feedback"): one reported failure of an AI
/// session / CI job / GitStation / a person. `signature` = SHA-256 hex of tool + errorCode + the normalized,
/// redacted first lines (services/feedback/signature); `signatureText` is that redacted, normalized part and
/// `excerpt` the redacted detail (at most 4 KB). A repeat of the same signature by the same token within a
/// minute is folded into the first row (`repeatCount`). projectId null = outside any project.
model FailureEvent {
  id            String             @id @default(cuid())
  projectId     String?
  /// "agent" | "ci" | "gitstation" | "manual".
  source        String             @db.VarChar(16)
  signature     String             @db.VarChar(64)
  signatureText String             @db.VarChar(1000)
  tool          String             @db.VarChar(100)
  errorCode     String?            @db.VarChar(64)
  excerpt       String             @db.Text
  sessionRef    String?            @db.VarChar(100)
  branch        String?            @db.VarChar(255)
  /// Reports folded into this row (same signature, same reporter, within a minute).
  repeatCount   Int                @default(1)
  reportedById  String
  createdAt     DateTime           @default(now())
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reportedBy    User               @relation(fields: [reportedById], references: [id], onDelete: Cascade)
  resolutions   LessonResolution[]

  @@index([signature, createdAt])
  @@index([sessionRef, reportedById, createdAt])
  @@index([projectId, createdAt])
  @@index([createdAt])
  @@map("failure_event")
}

/// A lesson learned from a failure (W11). state: draft → confirmed (a Maintainer / SM or above) →
/// systemized (linked to a PBI / gate / test) | retired. Only confirmed / systemized, non-confidential
/// lessons are ever returned to AI sessions. scope: "global" | "tech:<name>" | "project:<id>" (lower case);
/// (signature, scope) is unique. evidence is a JSON array of link strings (Text, like other JSON columns).
model Lesson {
  id                   String             @id @default(cuid())
  signature            String             @db.VarChar(64)
  scope                String             @default("global") @db.VarChar(120)
  state                String             @default("draft") @db.VarChar(16)
  symptom              String             @db.Text
  cause                String?            @db.Text
  fix                  String?            @db.Text
  /// A command that shows the fix works.
  verify               String?            @db.Text
  evidence             String?            @db.Text
  errorCode            String?            @db.VarChar(64)
  confidential         Boolean            @default(false)
  /// Failures with this signature reported while the lesson was not retired.
  hits                 Int                @default(0)
  resolvedCount        Int                @default(0)
  lastSeenAt           DateTime?
  confirmedById        String?
  confirmedAt          DateTime?
  /// "<kind>:<ref>" (pbi / gate / test) set by systemize.
  systemizedRef        String?            @db.VarChar(500)
  /// When the recurrence step proposed a prevention PBI (once per signature; null = not yet).
  preventionProposedAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  confirmedBy          User?              @relation("LessonConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  resolutions          LessonResolution[]

  @@unique([signature, scope])
  @@index([state, lastSeenAt])
  @@index([scope])
  @@map("lesson")
}

/// How a failure was fixed (W11): ties a failure event (one resolution per event) to a lesson.
/// diffSummary is redacted; verifiedCommand is the command the reporter ran to check the fix.
model LessonResolution {
  id              String       @id @default(cuid())
  failureEventId  String
  lessonId        String
  diffSummary     String       @db.Text
  verifiedCommand String?      @db.Text
  createdAt       DateTime     @default(now())
  failureEvent    FailureEvent @relation(fields: [failureEventId], references: [id], onDelete: Cascade)
  lesson          Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([failureEventId])
  @@index([lessonId, createdAt])
  @@map("lesson_resolution")
}

/// 計画を作る (plan 12 §2.1 / §3.6, E5): one estimate run — the template with the actuals, the confirmed lesson rules and
/// the levelling applied. Approving it (/plan/load with estimateRunId) recomputes everything on the server; a run whose
/// inputs changed (inputHash) or that is older than 24 h is refused (409 PLAN_ESTIMATE_STALE). Read only inside its
/// project with plan.estimate; the per-person part (ownerPlan) also needs plan.viewMemberLoad. engineInput and
/// schedule never leave the server.
model PlanEstimateRun {
  id            String   @id @default(cuid())
  projectId     String
  createdById   String?
  createdAt     DateTime @default(now())
  /// createdAt + 24 h: approving later is refused.
  expiresAt     DateTime
  /// createdAt + 1 year (retention; purged with its feedback).
  purgeAfter    DateTime
  /// Reference day R of the matching (plan 12 §3.1).
  referenceDate DateTime @db.Date
  startDate     DateTime @db.Date
  skipWeekends  Boolean  @default(false)
  lineage       String   @db.VarChar(200)
  projectType   String   @db.VarChar(40)
  sourceRef     String?  @db.VarChar(300)
  templateHash  String   @db.Char(64)
  /// sha256 of the canonical inputs (rules + versions, snapshot items, template hash, R, capacity, roles, method).
  inputHash     String   @db.Char(64)
  methodVersion String   @db.VarChar(16)
  /// The per-lineage default (plan 12 §5): off = the template days, with the reason.
  gateOn        Boolean
  gateReason    String?  @db.VarChar(40)
  /// E6 (LLM explanation): model, prompt version and the sources the text was written from.
  llmModel      String?  @db.VarChar(64)
  promptVersion String?  @db.VarChar(32)
  llmSourceIds  String[]
  /// The explanation text { ja, en, id } (E6); shown only to a reader who can view every id in llmSourceIds.
  llmExplanation      Json?
  /// null = not written yet | ready | failed (the LLM did not answer usably; logged) | skipped (nothing to explain)
  llmExplanationState String?   @db.VarChar(16)
  llmExplainedAt      DateTime?
  /// The schedule to load: template + rules, durationDays = D50, notBeforeOffsetDays from levelling. No owners.
  schedule      Json
  /// The card (small, independent of the number of items).
  summary       Json
  /// Per-leaf evidence by id (sources as snapshot item / project ids); filtered again for every reader.
  evidence      Json
  /// Owners per key, moves, before / after utilization (per person: plan.viewMemberLoad).
  ownerPlan     Json
  /// What the run was computed from (for the approval recompute): visible project ids of the creator, the hidden-source
  /// state used, role assignments, snapshot items, rules. Server only.
  engineInput   Json

  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?                  @relation("PlanEstimateRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  feedback  PlanEstimateFeedback[]
  loads     PlanScheduleLoad[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([purgeAfter])
  @@map("plan_estimate_run")
}

/// One LLM rule-draft request per finalized snapshot (plan 12 §3.4 E6 part 1). Queued by 実績を確定, processed by the
/// worker's night batch at background priority; the drafts are plan_lesson_rule rows (draft, project scope, llm) and
/// change nothing until a PO / SM confirms them one at a time. sourceIds = the sources given to the LLM.
model PlanRuleDraftJob {
  id            String    @id @default(cuid())
  projectId     String
  snapshotId    String    @unique
  /// queued | running | done | failed | skipped
  status        String    @default("queued") @db.VarChar(16)
  attempts      Int       @default(0)
  draftsCreated Int       @default(0)
  draftsDropped Int       @default(0)
  llmModel      String?   @db.VarChar(64)
  promptVersion String?   @db.VarChar(32)
  sourceIds     String[]  @default([])
  lastError     String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot PlanActualsSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([projectId])
  @@map("plan_rule_draft_job")
}

/// One AI review request per finalized snapshot (plan 12 E6, handoff 2026-11-05 "次の案" 1): the local LLM reads the
/// snapshot's own leaves (names, days, plan-item notes; never a leaf citing a PBI that is confidential now) and the
/// finalize note, and PROPOSES per leaf to exclude it from learning or to treat its overrun as waiting. Queued by
/// 実績を確定, processed by the night batch at background priority; the proposals change nothing until a PO / SM
/// accepts one. sourceIds = what was given to the LLM ("item:<id>", "note:<snapshotId>").
model PlanActualsReviewJob {
  id               String    @id @default(cuid())
  projectId        String
  snapshotId       String    @unique
  /// queued | running | done | failed | skipped
  status           String    @default("queued") @db.VarChar(16)
  attempts         Int       @default(0)
  proposalsCreated Int       @default(0)
  proposalsDropped Int       @default(0)
  /// Valid proposals not written because the project already held the most pending ones (shown on the screen).
  proposalsCapped  Int       @default(0)
  llmModel         String?   @db.VarChar(64)
  promptVersion    String?   @db.VarChar(32)
  sourceIds        String[]  @default([])
  lastError        String?   @db.VarChar(500)
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  project   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot  PlanActualsSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  proposals PlanActualsReviewProposal[]

  @@index([status, createdAt])
  @@index([projectId])
  @@map("plan_actuals_review_job")
}

/// An AI proposal for one snapshot leaf (at most one per leaf): exclude_from_learning | treat_as_waiting, with the
/// reason as an exact quote of the leaf's text or the finalize note, and the model's confidence (low | medium | high).
/// state: pending → accepted | rejected by a PO / SM (plan.actualsReview, audited; deciding again is allowed while the
/// snapshot is current). Accepting sets plan_actuals_item.learningUse; rejecting leaves (or puts back) the leaf as
/// recorded. superseded = the snapshot was re-finalized before a decision; expired = still pending after 90 days.
model PlanActualsReviewProposal {
  id             String    @id @default(cuid())
  projectId      String
  snapshotId     String
  snapshotItemId String    @unique
  jobId          String?
  kind           String    @db.VarChar(24)
  quote          String    @db.VarChar(1000)
  /// Where the quote is from: item (the leaf's own name / notes) | note (the finalize note).
  quoteSource    String    @default("item") @db.VarChar(8)
  confidence     String    @db.VarChar(8)
  state          String    @default("pending") @db.VarChar(16)
  /// Optimistic lock of the decision.
  version        Int       @default(0)
  llmModel       String?   @db.VarChar(64)
  promptVersion  String?   @db.VarChar(32)
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?
  decidedById    String?

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot  PlanActualsSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item      PlanActualsItem       @relation(fields: [snapshotItemId], references: [id], onDelete: Cascade)
  job       PlanActualsReviewJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  decidedBy User?                 @relation("PlanActualsReviewDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([projectId, state])
  @@index([snapshotId])
  @@map("plan_actuals_review_proposal")
}

/// 利用者の反応 to an estimate run (plan 12 §2.1, E5): one kind per leaf key and person (a repeat click updates it).
model PlanEstimateFeedback {
  id        String   @id @default(cuid())
  runId     String
  key       String   @db.VarChar(40)
  /// too_high | too_low | rule_not_applicable | other
  kind      String   @db.VarChar(24)
  /// Up to 500 characters; shown only inside the run's project.
  note      String?  @db.VarChar(500)
  userId    String?
  createdAt DateTime @default(now())

  run  PlanEstimateRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User?           @relation("PlanEstimateFeedbackBy", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([runId, key, userId, kind])
  @@map("plan_estimate_feedback")
}

/// Hidden-source state per aggregation unit (plan 12 §3.2 rule 2, E5): what the last published estimate used from
/// sources a reader may not see, so a change moves two at a time. Global across projects; written under an advisory
/// lock in the run's transaction. Holds counts only (HiddenState), never a source id.
model PlanEstimateHiddenState {
  unitKey   String   @id @db.VarChar(300)
  state     Json
  updatedAt DateTime @updatedAt

  @@map("plan_estimate_hidden_state")
}

/// Backtest results per lineage (plan 12 §5): the per-lineage default switches on only when the method beats the
/// template here. Written by scripts/plan-backtest.ts --record; no row = off.
model PlanEstimateEval {
  id                   String   @id @default(cuid())
  lineage              String   @db.VarChar(200)
  evaluatedOn          DateTime @db.Date
  methodVersion        String   @db.VarChar(16)
  n                    Int
  mape                 Float
  mapeTemplate         Float
  p80Hit               Float
  endErrorDays         Float
  endErrorTemplateDays Float
  /// Finished projects of the lineage that could not be scored (no loaded schedule, unreadable schedule, no leaf
  /// with an actual and template days). Null on rows written before it was recorded.
  skipped              Int?
  /// sha256 of the lineage's learnable snapshots (id + version) the row was computed from: the gate treats a row whose
  /// hash differs from the current one as outdated. Null on rows written before it was recorded (= outdated).
  inputHash            String?  @db.Char(64)
  /// The approved estimator settings the row was computed with (null = the defaults). The gate treats a row whose
  /// settings are not the lineage's active ones as outdated.
  paramApprovalId      String?  @db.VarChar(191)
  createdAt            DateTime @default(now())

  approvals     PlanEstimateGateApproval[]
  paramApproval PlanEstimateParamApproval? @relation(fields: [paramApprovalId], references: [id], onDelete: SetNull)

  @@index([lineage, evaluatedOn(sort: Desc)])
  @@map("plan_estimate_eval")
}

/// An administrator's approval to propose durations from actuals for one lineage (plan 12 §8 item 6: real data turns
/// the default on only after a person has looked at the backtest). Bound to the method version: a new method needs a
/// new approval. Without an active row the run keeps the template's durations even when the backtest passes.
/// Rows are never deleted (history): withdrawing or a failing backtest ends the row (endedAt); a new approval is a new
/// row. UNIQUE NULLS NOT DISTINCT (lineage, endedAt) in the migration: at most one active approval per lineage.
model PlanEstimateGateApproval {
  id            String    @id @default(cuid())
  lineage       String    @db.VarChar(200)
  methodVersion String    @db.VarChar(16)
  /// The backtest row the administrator saw when approving.
  evalId        String?   @db.VarChar(191)
  approvedById  String?
  approvedAt    DateTime  @default(now())
  endedAt       DateTime?
  endedById     String?
  /// withdrawn (an administrator) | failed (the latest backtest no longer passes) | method (a new method version)
  endReason     String?   @db.VarChar(16)

  eval       PlanEstimateEval? @relation(fields: [evalId], references: [id], onDelete: SetNull)
  approvedBy User?             @relation("PlanEstimateGateApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  endedBy    User?             @relation("PlanEstimateGateEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  @@unique([lineage, endedAt], map: "plan_estimate_gate_approval_one_active_key")
  @@index([lineage, approvedAt(sort: Desc)])
  @@map("plan_estimate_gate_approval")
}

/// One act-as action asked from Kanflow through GitStation's confirmation (GitStation ADR-0025): approve / withdraw a
/// merge request (plan 11 K4, F-36) or bind / unbind a repository to this Kanflow project (plan 11 §5.7 X3). The
/// `state` Kanflow put into GitStation's confirmation URL, bound to the Kanflow user who asked and to what they asked
/// for. Claimed once ("確認しました"); `claimingAt` serialises a double press, `finishedAt` ends the row.
/// Rows are removed a day after they expire (no history is needed: GitStation's audit log holds the action).
/// CHECK git_mr_approval_attempt_subject_chk: an MR intent has gitLinkId + headSha only; binding_set has
/// stationProjectId + resolvesWorkItems (+ bindingId when an existing binding is changed); binding_remove has
/// stationProjectId + bindingId. The Kanflow project a binding names is `projectId`.
/// CHECK git_mr_approval_attempt_outcome_chk: each intent ends with its own outcomes (plus discarded / failed).
model GitMrApprovalAttempt {
  id          String    @id @default(cuid())
  projectId   String
  userId      String
  /// approve / unapprove: the merge request link.
  gitLinkId   String?
  /// "approve" | "unapprove" | "binding_set" | "binding_remove"
  intent      String    @db.VarChar(16)
  /// approve / unapprove: the head the person was shown (40 / 64 hex): a claim for another head is discarded.
  headSha     String?   @db.VarChar(64)
  /// binding intents: GitStation's id of the repository (its project) bound / unbound.
  stationProjectId BigInt?
  /// binding_remove, or binding_set changing an existing binding: GitStation's binding id.
  bindingId   BigInt?
  /// binding_set: the setting the person confirms (true = code repository, false = shared spec repository).
  resolvesWorkItems Boolean?
  /// The state, AES-256-GCM sealed by lib/secret-box (it is sent once more, to the claim).
  stateCipher String    @db.Text
  /// GitStation's confirmation page expires after 10 minutes; Kanflow keeps the row as long.
  expiresAt   DateTime
  /// A claim is being sent (a second press within 30 s is refused).
  claimingAt  DateTime?
  finishedAt  DateTime?
  /// approved | withdrawn | unchanged | bound | updated | removed | discarded | failed
  outcome     String?   @db.VarChar(16)
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gitLink     GitLink?  @relation(fields: [gitLinkId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([gitLinkId])
  @@map("git_mr_approval_attempt")
}

/// One run of the deterministic parameter search of a lineage (services/plan-estimate-eval/param-search.ts): the
/// outcome (a proposal, or "keep the defaults" with why), the settings, and the backtest metrics of the defaults and of
/// the proposal (lineage aggregates only — no project ids; administrators only). An administrator approves or rejects a
/// proposal; a newer search supersedes a pending one. Rows are never deleted (history).
model PlanEstimateParamProposal {
  id            String    @id @default(cuid())
  lineage       String    @db.VarChar(200)
  methodVersion String    @db.VarChar(16)
  /// lineageInputHash the search was computed from: a proposal of other snapshots cannot be approved.
  inputHash     String    @db.Char(64)
  /// propose | keep_default
  outcome       String    @db.VarChar(16)
  /// Why the defaults are kept (null for a proposal): not_enough_actuals | no_improvement | holdout_worse | not_passing | time_budget
  reason        String?   @db.VarChar(24)
  /// The proposed settings ({ outlierMads, halfLifeDays, shrinkK, spreadPrior }; the defaults when kept).
  params        Json
  /// { before, after, skipped }: CandidateMetrics of the defaults and of the proposal (full / search / holdout).
  metrics       Json
  candidates    Int
  evaluated     Int
  timedOut      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  /// approved | rejected | superseded (null = pending, or a "keep the defaults" row)
  decision      String?   @db.VarChar(16)
  decidedAt     DateTime?
  decidedById   String?

  decidedBy User?                       @relation("PlanEstimateParamDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  approvals PlanEstimateParamApproval[]

  @@index([lineage, createdAt(sort: Desc)])
  @@map("plan_estimate_param_proposal")
}

/// The estimator settings an administrator approved for a lineage (from a proposal). Used by every run of the lineage
/// while active; a later backtest that fails with them ends it (the lineage falls back to the defaults), as does a new
/// method version, a newer approval or an administrator. Never deleted (history). UNIQUE NULLS NOT DISTINCT
/// (lineage, endedAt) in the migration: at most one active row per lineage.
model PlanEstimateParamApproval {
  id            String    @id @default(cuid())
  lineage       String    @db.VarChar(200)
  methodVersion String    @db.VarChar(16)
  proposalId    String?   @db.VarChar(191)
  /// A copy of the approved settings (the proposal row may be read without them).
  params        Json
  approvedById  String?
  approvedAt    DateTime  @default(now())
  endedAt       DateTime?
  endedById     String?
  /// withdrawn (an administrator returned to the defaults) | failed (a backtest with them no longer passes) |
  /// method (a new method version) | replaced (a newer approval)
  endReason     String?   @db.VarChar(16)

  proposal   PlanEstimateParamProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  approvedBy User?                      @relation("PlanEstimateParamApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  endedBy    User?                      @relation("PlanEstimateParamEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  evals      PlanEstimateEval[]

  @@unique([lineage, endedAt], map: "plan_estimate_param_approval_one_active_key")
  @@index([lineage, approvedAt(sort: Desc)])
  @@map("plan_estimate_param_approval")
}

/// ボード (docs/plan/10-board.md): a free drawing board of a project. Any number per project, every project type.
/// Deleting moves it to the project trash (deletedAt; purged after the trash retention). The content never leaves
/// Kanflow: not returned through MCP, not sent to GitStation or to the background LLM jobs, not in the activity log.
model Board {
  id          String       @id @default(cuid())
  projectId   String
  title       String       @db.VarChar(120)
  sortOrder   Int          @default(0)
  /// Plain User ids (no FK, like Project.deletedById): the board outlives the account.
  createdById String?
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sheets      BoardSheet[]

  @@index([projectId, deletedAt])
  @@map("board")
}

/// One sheet (tab) of a board. A board always keeps at least one.
model BoardSheet {
  id        String         @id @default(cuid())
  boardId   String
  name      String         @db.VarChar(60)
  sortOrder Int            @default(0)
  /// Change counter: +1 on every accepted element write. `GET …/elements?since=<rev>` returns what changed after it.
  rev       Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  board     Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  elements  BoardElement[]

  @@index([boardId, sortOrder])
  @@map("board_sheet")
}

/// One drawn element = one row, so two people changing different elements never overwrite each other.
/// `data` is the element as the client wrote it ({ type, … }); the server validates the known types and keeps
/// unknown ones untouched (a newer client's image / table / link needs no migration).
model BoardElement {
  id          String     @id @default(cuid())
  sheetId     String
  /// Client-generated id, unique within the sheet.
  elementId   String     @db.VarChar(40)
  /// Per-element counter set by the writer; the server keeps the higher one (lib/board/merge.ts).
  version     Int
  data        Json
  /// Tombstone: the element was deleted (kept so that a delta read can tell other clients).
  deleted     Boolean    @default(false)
  /// The sheet's `rev` at which this row was last written.
  rev         Int
  /// Plain User id (no FK).
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  sheet       BoardSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@unique([sheetId, elementId])
  @@index([sheetId, rev])
  @@map("board_element")
}
