model UserProjectCategory {
  id          String                          @id @default(cuid())
  userId      String
  name        String
  color       String                          @default("gray")
  sortOrder   Int                             @default(0)
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt
  user        User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments UserProjectCategoryAssignment[]

  @@unique([userId, name])
  @@index([userId])
}

model UserProjectCategoryAssignment {
  id         String              @id @default(cuid())
  categoryId String
  projectId  String
  category   UserProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([categoryId, projectId])
  @@index([categoryId])
  @@index([projectId])
}

/// Both-language storage for user-entered free text (src/lib/translation).
/// One row per (entity, field). The row doubles as the background-translation
/// queue: status / priority / attempts live here, there is no separate queue.
/// The source-locale column holds the original text verbatim; the other side
/// is filled by the background worker (or by the legacy bilingual-pair split).
model FieldTranslation {
  entityType   String    @map("entity_type") @db.VarChar(64)
  entityId     String    @map("entity_id") @db.VarChar(191)
  field        String    @db.VarChar(64)
  sourceLocale String    @map("source_locale") @db.Char(2)
  sourceHash   String    @map("source_hash") @db.VarChar(64)
  textJa       String?   @map("text_ja") @db.Text
  textId       String?   @map("text_id") @db.Text
  /// English side (added 2026-10; NULL on older rows until the worker fills it).
  textEn       String?   @map("text_en") @db.Text
  status       String    @default("pending") @db.VarChar(16)
  priority     Int       @default(0)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error") @db.Text
  model        String?   @db.VarChar(128)
  requestedAt  DateTime  @default(now()) @map("requested_at")
  startedAt    DateTime? @map("started_at")
  translatedAt DateTime? @map("translated_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@id([entityType, entityId, field])
  @@index([status, priority(sort: Desc), requestedAt])
  @@fulltext([textJa, textId], map: "ft_translation_text")
  @@map("field_translation")
}

/// Shared translation glossary: a correction by one user is applied to every
/// later translation. Registered from `用語<<訳語>>` markup in any text input
/// or from /admin/glossary. (source, target, term_norm) is unique; the reverse
/// direction is auto-registered (auto_reverse=true) until edited by hand.
model Glossary {
  id           String   @id @default(cuid())
  sourceLocale String   @map("source_locale") @db.Char(2)
  targetLocale String   @map("target_locale") @db.Char(2)
  term         String   @db.VarChar(255)
  termNorm     String   @map("term_norm") @db.VarChar(255)
  translation  String   @db.VarChar(500)
  note         String?  @db.Text
  autoReverse  Boolean  @default(false) @map("auto_reverse")
  usageCount   Int      @default(0) @map("usage_count")
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([sourceLocale, targetLocale, termNorm])
  @@index([sourceLocale, targetLocale])
  @@map("glossary")
}

// ---------------------------------------------------------------------------
// P2 collaboration foundation (migration 20261002000000_p2_collab_foundation)
// Table/column naming follows the core models (PascalCase table = model name,
// camelCase columns, cuid ids), not the snake_case translation tables.
// ---------------------------------------------------------------------------

/// Audit / change history. One row per mutation of a tracked entity.
/// entityType: project | pbi | sprint | sprint_task | icebox | comment | ...
/// action: create | update | delete | restore | status_change | ...
/// actorName is denormalized so history stays readable if the actor is gone.
/// diff is a JSON string ({ field: [before, after] }) — Text, like the other
/// JSON-in-Text columns (AiReport.structured / meta).
model ActivityLog {
  id         String   @id @default(cuid())
  projectId  String
  entityType String   @db.VarChar(32)
  entityId   String   @db.VarChar(191)
  action     String   @db.VarChar(32)
  actorId    String?
  actorName  String?
  diff       String?  @db.Text
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

/// In-app notification (bell). payload is a JSON string rendered client-side.
/// dedupeKey (e.g. "due_soon:<taskId>:2026-10-02") makes scheduled jobs
/// idempotent: a repeat insert with the same (recipientId, dedupeKey) fails
/// with P2002 and is skipped. NULL keys never collide (MySQL unique semantics),
/// so ad-hoc notifications simply leave it null.
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  type        String    @db.VarChar(32)
  entityType  String?   @db.VarChar(32)
  entityId    String?   @db.VarChar(191)
  projectId   String?
  payload     String?   @db.Text
  dedupeKey   String?   @db.VarChar(191)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt])
  @@index([projectId])
}

/// Per-user opt-out per notification type. Missing row = enabled.
model NotificationPreference {
  userId  String
  type    String  @db.VarChar(32)
  enabled Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

/// Comment thread on a PBI / sprint task / icebox request (polymorphic:
/// entityType = pbi | sprint_task | icebox, entityId = that row's id).
/// Soft-deleted comments keep their row (deletedAt) so thread order and
/// mentions stay intact. author is Restrict: users are deactivated, never
/// deleted, and a comment must not silently vanish with its author.
model Comment {
  id         String           @id @default(cuid())
  projectId  String
  entityType String           @db.VarChar(32)
  entityId   String           @db.VarChar(191)
  authorId   String
  body       String           @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  editedAt   DateTime?
  deletedAt  DateTime?
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  mentions   CommentMention[]

  teamMessage TeamMessage?

  @@index([entityType, entityId, createdAt])
  @@index([projectId, createdAt])
  @@index([authorId])
  @@fulltext([body], map: "ft_comment_body")
}

/// @mentions parsed from Comment.body (drives mention notifications).
model CommentMention {
  commentId String
  userId    String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

/// Normalized sprint-task assignee (replaces the comma-separated
/// SprintBacklogItem.assignee string; backfill: scripts/migrate-assignees.ts).
model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime          @default(now())
  task      SprintBacklogItem @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// P3 AI extensions (migration 20261003000000_p3_ai)
// ---------------------------------------------------------------------------

/// Persisted project chat conversation. Private to its owner (userId):
/// nobody else — system admins included — can list or read it. Soft delete
/// (deletedAt); the worker purges deleted threads after 30 days and every
/// thread idle longer than CHAT_RETENTION_DAYS (default 180).
model ChatThread {
  id        String        @id @default(cuid())
  projectId String
  userId    String
  title     String        @db.VarChar(200)
  createdAt DateTime      @default(now())
  /// Last activity (bumped on every stored message); the list is ordered by it.
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([projectId, userId, deletedAt, updatedAt])
  @@index([deletedAt])
  @@index([updatedAt])
}

/// One stored chat turn. role: user | assistant. toolEvents is a JSON string
/// (tool calls, proposals) — Text like the other JSON-in-Text columns.
/// partial = the answer was cut short (stopped by the user, error, timeout).
model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  role       String     @db.VarChar(16)
  content    String     @db.MediumText
  toolEvents String?    @db.Text
  partial    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Queue of long-running AI generations (progress report, sprint review).
/// Run by the worker (AI_TRANSLATION_WORKER=external) or inside the web
/// process (inprocess). status: queued | running | done | failed | cancelled.
/// activeKey = "<projectId>:<kind>[:<scope>]" while queued/running and NULL
/// afterwards: the unique index allows one active job per project + kind.
/// params is a JSON string. resultReportId is a plain AiReport id (no FK:
/// reports are pruned by retention independently).
model AiJob {
  id             String    @id @default(cuid())
  projectId      String
  userId         String?
  kind           String    @db.VarChar(32)
  params         String?   @db.Text
  status         String    @default("queued") @db.VarChar(16)
  progress       Int?
  attempts       Int       @default(0)
  activeKey      String?   @unique @db.VarChar(191)
  resultReportId String?
  error          String?   @db.Text
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// P4 personal access tokens + metrics (migration 20261005000000_api_tokens_metrics)
// ---------------------------------------------------------------------------

/// Personal access token for the read-only REST API (/api/v1). Only the
/// SHA-256 hex of the token is stored (tokenHash, unique → constant-time
/// lookup by index); the plain token ("kfl_" + 32 random bytes base64url) is
/// shown once at creation. prefix = the first 12 chars ("kfl_" + 8) for display.
/// scopes is a JSON array string (only "read" today). userTokenVersion copies
/// User.tokenVersion at creation: a later bump (deactivate / role change /
/// password reset) invalidates the token even if the revoke hook missed it.
model ApiToken {
  id               String    @id @default(cuid())
  userId           String
  name             String    @db.VarChar(100)
  tokenHash        String    @unique @db.Char(64)
  prefix           String    @db.VarChar(16)
  scopes           String    @db.VarChar(191)
  userTokenVersion Int       @default(0)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([createdAt])
}

/// Periodic snapshot of the in-process request / AI / queue metrics (web
/// process timer, every 5 min). data is a JSON string (Text like the other
/// JSON-in-Text columns). Pruned after METRICS_RETENTION_DAYS (default 14).
model MetricSnapshot {
  id      String   @id @default(cuid())
  takenAt DateTime @default(now())
  data    String   @db.Text

  @@index([takenAt])
}

/// Per-project GitLab integration switch and access token. A project without
/// a row (or enabled = false) shows no Git UI at all — Kanflow is also used by
/// process-improvement teams that never touch Git.
model GitIntegration {
  projectId           String   @id
  enabled             Boolean  @default(false)
  /// Access token (group or project token, read_api), AES-256-GCM sealed by lib/secret-box. Never returned by the API.
  tokenCipher         String?  @db.Text
  /// Last 4 characters, shown as "••••abcd" so people can tell which token is set.
  tokenHint           String?  @db.VarChar(8)
  /// When every merge request of a PBI is merged, its in-progress tasks of the active sprint become done.
  autoCompleteOnMerge Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("git_integration")
}

/// One GitLab repository of a project (a project may have several: front end,
/// API, edge ...). Polled by lib/git/poller (GitLab cannot reach the LAN, so no webhooks).
model GitRepository {
  id          String    @id @default(cuid())
  projectId   String
  /// Display name ("API", "フロント").
  name        String    @db.VarChar(100)
  /// https://host/group/repo as entered (normalised, no .git).
  webUrl      String    @db.VarChar(1024)
  /// https://host — the API base.
  apiBase     String    @db.VarChar(255)
  /// group/sub/repo
  repoPath    String    @db.VarChar(512)
  /// GitLab numeric project id (resolved on the connection test).
  externalId  Int?
  /// Optional per-repository token (overrides the integration token).
  tokenCipher String?   @db.Text
  tokenHint   String?   @db.VarChar(8)
  /// Last successful sync and the watermark the next one asks from.
  syncedAt    DateTime?
  syncCursor  DateTime?
  lastError   String?   @db.VarChar(500)
  lastErrorAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links       GitLink[]

  @@index([projectId])
  @@map("git_repository")
}

/// A merge request, branch or commit that names a PBI (PBI-123 in its title,
/// branch name or message). One row per (repository, object, PBI).
model GitLink {
  id            String             @id @default(cuid())
  projectId     String
  repositoryId  String
  backlogItemId String
  /// "mr" | "branch" | "commit"
  kind          String             @db.VarChar(16)
  /// MR iid, branch name or commit sha.
  ref           String             @db.VarChar(255)
  title         String             @db.VarChar(500)
  url           String             @db.VarChar(1024)
  /// MR: opened | merged | closed | locked; null for branches / commits.
  state         String?            @db.VarChar(16)
  /// Latest pipeline status (MR head pipeline / branch / commit), when known.
  pipeline      String?            @db.VarChar(24)
  author        String?            @db.VarChar(191)
  sourceBranch  String?            @db.VarChar(255)
  /// When it last changed on GitLab (MR updated_at, commit date, branch head date).
  occurredAt    DateTime
  mergedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository    GitRepository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  backlogItem   ProductBacklogItem @relation(fields: [backlogItemId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, kind, ref, backlogItemId])
  @@index([backlogItemId])
  @@index([projectId, occurredAt])
  @@map("git_link")
}

// ─── マイルストーン・検収ボード (general projects, 2026-10) ────────────────
// The stages ARE the project's top-level PlanItems (name / dates / status /
// 完了条件 notes are read from there, never copied); these tables keep only
// the board's own state. Users are referenced by id + name (no FK).

/// Board settings of a project: the チェック項目 呼び名 and the optional parts.
model MilestoneBoard {
  projectId     String   @id
  /// 呼び名 of the check items (検収 / テスト / 評価 …); null = the UI default.
  checkLabel    String?  @db.VarChar(40)
  budgetEnabled Boolean  @default(false)
  /// 推移 (monthly metric trend) tab shown even before a metric exists.
  trendEnabled  Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("milestone_board")
}

/// Idempotency marker: this template load's checks / documents / flags were
/// copied onto the board (lazily, on the first board read after the load).
model MilestoneBoardSeed {
  applicationId String   @id
  projectId     String
  seededAt      DateTime @default(now())

  application PlanTemplateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestone_board_seed")
}

/// A ticked 完了条件 of a stage. The condition text lives in PlanItem.notes
/// ("完了条件:\n- …"); the row exists only while the condition is ticked.
model MilestoneChecklistState {
  id            String   @id @default(cuid())
  planItemId    String
  label         String   @db.VarChar(255)
  checkedById   String?
  checkedByName String?  @db.VarChar(255)
  checkedAt     DateTime @default(now())

  planItem PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)

  @@unique([planItemId, label])
  @@map("milestone_checklist_state")
}

/// チェック項目 (検収 / テスト / 評価 / 竣工検査 …) with its criterion and result.
model AcceptanceCheck {
  id             String    @id @default(cuid())
  projectId      String
  planItemId     String?
  name           String    @db.VarChar(255)
  criterion      String?   @db.Text
  /// passed | conditional | failed | null (not checked yet)
  result         String?   @db.VarChar(16)
  /// 立会者 (free text: customer / maker staff are often not users).
  witness        String?   @db.VarChar(255)
  /// Day of the check (UTC midnight).
  checkedAt      DateTime?
  note           String?   @db.Text
  recordedById   String?
  recordedByName String?   @db.VarChar(255)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planItem PlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  @@index([projectId, sortOrder])
  @@index([planItemId])
  @@map("acceptance_check")
}

/// 残課題 (punch list item).
model PunchItem {
  id            String       @id @default(cuid())
  projectId     String
  planItemId    String?
  title         String       @db.VarChar(255)
  detail        String?      @db.Text
  /// A project member (id + name) or just a name (e.g. the maker's engineer).
  assigneeId    String?
  assigneeName  String?      @db.VarChar(255)
  dueDate       DateTime?
  /// open | in_progress | done
  status        String       @default("open") @db.VarChar(16)
  closedAt      DateTime?
  sortOrder     Int          @default(0)
  createdById   String?
  createdByName String?      @db.VarChar(255)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  photos        PunchPhoto[]

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planItem PlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([planItemId])
  @@map("punch_item")
}

/// Photo of a 残課題 (stored like PbiAttachment, counted in the project quota).
model PunchPhoto {
  id           String    @id @default(cuid())
  punchItemId  String
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  createdAt    DateTime  @default(now())
  punchItem    PunchItem @relation(fields: [punchItemId], references: [id], onDelete: Cascade)

  @@index([punchItemId])
  @@map("punch_photo")
}

/// 引き渡し資料 (a document to be handed over), with received state and files.
model HandoverDocument {
  id             String         @id @default(cuid())
  projectId      String
  name           String         @db.VarChar(255)
  /// pending | received
  status         String         @default("pending") @db.VarChar(16)
  receivedAt     DateTime?
  receivedByName String?        @db.VarChar(255)
  note           String?        @db.Text
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  files          HandoverFile[]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("handover_document")
}

/// A file attached to a 引き渡し資料 (stored like PbiAttachment, counted in the quota).
model HandoverFile {
  id             String           @id @default(cuid())
  documentId     String
  fileName       String
  originalName   String
  fileSize       Int
  mimeType       String
  uploadedByName String?          @db.VarChar(255)
  createdAt      DateTime         @default(now())
  document       HandoverDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("handover_file")
}

/// 予算 line (plan / actual in yen; DOUBLE keeps whole yen exact far past INT).
model BudgetLine {
  id         String   @id @default(cuid())
  projectId  String
  name       String   @db.VarChar(255)
  plannedYen Float?
  actualYen  Float?
  note       String?  @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("budget_line")
}

/// 推移 metric of a long-running project (e.g. 不良率 per month).
model MilestoneMetric {
  id            String                 @id @default(cuid())
  projectId     String
  name          String                 @db.VarChar(200)
  unit          String?                @db.VarChar(20)
  /// decrease | increase (which way is better)
  direction     String                 @default("decrease") @db.VarChar(10)
  baselineValue Float?
  targetValue   Float?
  sortOrder     Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  points        MilestoneMetricPoint[]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("milestone_metric")
}

/// One monthly value of a 推移 metric.
model MilestoneMetricPoint {
  id             String          @id @default(cuid())
  metricId       String
  /// "YYYY-MM"
  month          String          @db.VarChar(7)
  value          Float
  recordedByName String?         @db.VarChar(255)
  updatedAt      DateTime        @updatedAt
  metric         MilestoneMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, month])
  @@map("milestone_metric_point")
}
