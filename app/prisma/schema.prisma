generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                String                   @id @default(cuid())
  name              String
  email             String                   @unique
  password          String
  avatarUrl         String?                  @db.Text
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  isActive          Boolean                  @default(true)
  role              String                   @default("member")
  /// Bumped to revoke every JWT issued for this user (deactivate / role change / password reset).
  tokenVersion      Int                      @default(0)
  language          String                   @default("ja")
  employeeNumber    String?                  @unique
  department        String?
  accounts          Account[]
  memberships       ProjectMember[]
  sessions          Session[]
  projectCategories UserProjectCategory[]
  sections          UserSection[]
  favoriteProjects  UserProjectFavorite[]
  fixedTasks        UserFixedTask[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  comments          Comment[]
  commentMentions   CommentMention[]
  taskAssignments   TaskAssignee[]
  chatThreads       ChatThread[]
  aiJobs            AiJob[]
  ownedPlanItems    PlanItem[]               @relation("PlanItemOwner")
  apiTokens         ApiToken[]

  projectVisits ProjectVisit[]

  teamMessages        TeamMessage[]
  teamMessageMentions TeamMessageMention[]
  teamChatReads       TeamChatRead[]

  @@index([department])
}

/// A user-defined group of related sprint sub-tasks. `taskName` is the group's
/// display name (e.g. "設備購入"); children in `items` are the concrete sub-tasks
/// that get bulk-inserted under a single PBI when the group is picked from
/// the dropdown in the sprint task form.
/// A row in the project's master plan ("全体計画"). Unlimited nesting via
/// parentId. Leaves take progress from their status (progressMode "manual")
/// or from the PBIs linked to them ("linked"); parents roll up progress,
/// status and planned dates from their children (src/lib/plan-progress.ts).
/// Delay is computed (scheduleState), not stored: "delayed" is no longer a
/// status (migrated to "in_progress" in 20261004000000_plan_linkage).
model PlanItem {
  id                    String    @id @default(cuid())
  projectId             String
  parentId              String?
  name                  String    @db.VarChar(255)
  description           String?   @db.Text
  /// Null = 日程未定 (undated, e.g. a stage just loaded from a plan template).
  /// Both are set or both are null; a parent's span is derived from its dated children.
  plannedStart          DateTime?
  plannedEnd            DateTime?
  actualStart           DateTime?
  actualEnd             DateTime?
  progressPct           Int       @default(0)
  color                 String?   @db.VarChar(32)
  status                String    @default("not_started")
  sortOrder             Int       @default(0)
  isMilestone           Boolean   @default(false)
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  /// "manual" (status → %) | "linked" (% from linked PBIs; leaves only).
  progressMode          String    @default("manual") @db.VarChar(16)
  /// Optimistic-lock counter: bumped on every user update; stale writes get 409.
  version               Int       @default(0)
  baselineStart         DateTime?
  baselineEnd           DateTime?
  ownerId               String?
  deletedAt             DateTime?
  deletedById           String?
  /// 目安期間 (days) copied from a plan template stage; used by 「日程を仮置き」.
  durationDays          Int?
  /// The template load that created this row (null for hand-made rows).
  templateApplicationId String?

  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateApplication PlanTemplateApplication?  @relation(fields: [templateApplicationId], references: [id], onDelete: SetNull)
  parent              PlanItem?                 @relation("PlanItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children            PlanItem[]                @relation("PlanItemTree")
  owner               User?                     @relation("PlanItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  backlogItems        ProductBacklogItem[]
  successorDeps       PlanItemDependency[]      @relation("PlanDependencyPredecessor")
  predecessorDeps     PlanItemDependency[]      @relation("PlanDependencySuccessor")
  /// マイルストーン・検収ボード rows attached to this stage.
  checklistStates     MilestoneChecklistState[]
  acceptanceChecks    AcceptanceCheck[]
  punchItems          PunchItem[]

  @@index([projectId])
  @@index([parentId])
  @@index([projectId, sortOrder])
  @@index([projectId, deletedAt])
  @@index([ownerId])
  @@index([templateApplicationId])
}

/// Reusable rough plan (大枠の計画) loaded into 全体計画 as undated stages.
/// builtinKey set = one of the shipped 共通 templates (seeded lazily from
/// src/lib/plan-templates/builtins.ts; editable, resettable, never deleted).
/// content = PlanTemplateContent JSON (stages + checks / documents for the
/// マイルストーン・検収ボード). Users are referenced by id + name (no FK).
model PlanTemplate {
  id            String    @id @default(cuid())
  builtinKey    String?   @unique @db.VarChar(40)
  name          String    @db.VarChar(255)
  description   String?   @db.Text
  /// public | private (private = owner + admins only)
  visibility    String    @default("public") @db.VarChar(10)
  ownerId       String?
  ownerName     String?   @db.VarChar(255)
  content       String    @db.MediumText
  version       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  updatedById   String?
  updatedByName String?   @db.VarChar(255)
  deletedAt     DateTime?

  revisions    PlanTemplateRevision[]
  applications PlanTemplateApplication[]

  @@index([deletedAt, visibility])
  @@index([ownerId])
  @@map("plan_template")
}

/// Snapshot of a template after each save / reset (edit history).
model PlanTemplateRevision {
  id           String   @id @default(cuid())
  templateId   String
  version      Int
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  visibility   String   @db.VarChar(10)
  content      String   @db.MediumText
  /// create | update | reset | duplicate
  action       String   @db.VarChar(16)
  editedById   String?
  editedByName String?  @db.VarChar(255)
  editedAt     DateTime @default(now())

  template PlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, editedAt])
  @@map("plan_template_revision")
}

/// One load of a template into a project's plan (duplicate-load warning and
/// the link from created PlanItems back to the template content they came from).
model PlanTemplateApplication {
  id              String   @id @default(cuid())
  projectId       String
  templateId      String
  templateName    String   @db.VarChar(255)
  templateVersion Int
  /// The template content as loaded (later template edits never change it).
  content         String   @db.MediumText
  /// JSON string[] of the top-level PlanItem ids created by this load.
  createdRootIds  String   @db.Text
  appliedById     String?
  appliedByName   String?  @db.VarChar(255)
  appliedAt       DateTime @default(now())

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template      PlanTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  planItems     PlanItem[]
  /// Set once the マイルストーン・検収ボード copied this load's checks / documents.
  milestoneSeed MilestoneBoardSeed?

  @@index([projectId, templateId])
  @@index([templateId])
  @@map("plan_template_application")
}

/// Finish-to-start dependency between two plan items of one project
/// (predecessor must finish before successor starts). Informational only:
/// nothing is auto-scheduled.
model PlanItemDependency {
  id            String   @id @default(cuid())
  projectId     String
  predecessorId String
  successorId   String
  createdAt     DateTime @default(now())

  predecessor PlanItem @relation("PlanDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   PlanItem @relation("PlanDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([successorId])
  @@index([projectId])
}

model UserFixedTask {
  id        String              @id @default(cuid())
  userId    String
  taskName  String
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     UserFixedTaskItem[]

  @@index([userId])
}

model UserFixedTaskItem {
  id        String        @id @default(cuid())
  groupId   String
  taskName  String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  group     UserFixedTask @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id                       String                          @id @default(cuid())
  name                     String
  description              String?                         @db.Text
  status                   String                          @default("active")
  defaultCapacity          Int                             @default(0)
  sprintDurationDays       Int                             @default(7)
  pointUnit                String                          @default("SP")
  pointDescription         String?                         @db.Text
  language                 String                          @default("ja")
  // Team option: when true, saved free-text fields are auto-annotated with a
  // Japanese/Indonesian bilingual rendering (lib/ensure-bilingual.ts)
  bilingualMode            Boolean                         @default(false)
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  projectType              String                          @default("software")
  progressPct              Int                             @default(0)
  // Card tint on the project list: gray|red|orange|yellow|green|blue|indigo|purple|pink; null = default white
  cardColor                String?
  // Soft delete (trash). Null = live. deletedById is a plain User id (no FK,
  // like CalendarEvent.createdBy); ActivityLog holds the full audit trail.
  deletedAt                DateTime?
  deletedById              String?
  /// P3: per-project AI surveillance thresholds as a JSON string (Text, like
  /// the other JSON-in-Text columns). Null = defaults (lib/surveillance-settings.ts).
  surveillanceSettings     String?                         @db.Text
  attachmentFolders        AttachmentFolder[]
  calendarEvents           CalendarEvent[]
  iceboxItems              IceboxItem[]
  backlogItems             ProductBacklogItem[]
  productGoals             ProductGoal[]
  attachments              ProjectAttachment[]
  members                  ProjectMember[]
  releaseItems             ReleaseBacklogItem[]
  sprints                  Sprint[]
  sections                 ProjectSection[]
  categoryAssignments      UserProjectCategoryAssignment[]
  adminCategoryAssignments AdminCategoryAssignment[]
  favoritedBy              UserProjectFavorite[]
  planItems                PlanItem[]
  aiReports                AiReport[]
  activityLogs             ActivityLog[]
  notifications            Notification[]
  comments                 Comment[]
  chatThreads              ChatThread[]
  aiJobs                   AiJob[]

  visits ProjectVisit[]

  teamMessages  TeamMessage[]
  teamChatReads TeamChatRead[]

  /// Optional GitLab integration (off by default; see services/git).
  gitIntegration  GitIntegration?
  gitRepositories GitRepository[]
  gitLinks        GitLink[]

  /// Plan template loads into this project's 全体計画.
  planTemplateApplications PlanTemplateApplication[]

  /// マイルストーン・検収ボード (general projects).
  milestoneBoard    MilestoneBoard?
  milestoneSeeds    MilestoneBoardSeed[]
  acceptanceChecks  AcceptanceCheck[]
  punchItems        PunchItem[]
  handoverDocuments HandoverDocument[]
  budgetLines       BudgetLine[]
  milestoneMetrics  MilestoneMetric[]

  @@index([deletedAt])
  @@fulltext([name], map: "ft_project_name")
}

model AiReport {
  id         String   @id @default(cuid())
  projectId  String
  // What fired the investigation: surveillance | sprint_completed | manual
  trigger    String
  status     String   @default("done")
  title      String
  // One-line summary for list views
  summary    String?  @db.Text
  // Full markdown report produced by the agent (fallback rendering)
  body       String?  @db.Text
  // JSON: StructuredReport submitted via the submit_report tool (report-tool.ts).
  // Null for legacy reports / plain-text endings — the UI then renders body.
  structured String?  @db.Text
  // JSON: detected anomalies, tool call stats, duration ms
  meta       String?  @db.Text
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Section {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?          @db.Text
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserSection[]
  projects    ProjectSection[]
  categories  AdminCategory[]
}

model ProjectSection {
  projectId  String
  sectionId  String
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([projectId, sectionId])
  @@index([projectId])
  @@index([sectionId])
}

model UserSection {
  userId     String
  sectionId  String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
}

model UserProjectFavorite {
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model AdminCategory {
  id          String                    @id @default(cuid())
  name        String
  color       String                    @default("gray")
  sortOrder   Int                       @default(0)
  sectionId   String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  section     Section?                  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignments AdminCategoryAssignment[]

  @@unique([sectionId, name])
  @@index([sectionId])
}

model AdminCategoryAssignment {
  id         String        @id @default(cuid())
  categoryId String
  projectId  String
  category   AdminCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([categoryId, projectId])
  @@index([categoryId])
  @@index([projectId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProductGoal {
  id           String               @id @default(cuid())
  projectId    String
  title        String               @db.Text
  description  String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  backlogItems ProductBacklogItem[]
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@fulltext([title, description], map: "ft_goal_text")
}

model IceboxItem {
  id              String               @id @default(cuid())
  projectId       String
  displayId       Int
  author          String
  request         String               @db.Text
  background      String?              @db.Text
  policyDoc       String?              @db.Text
  planningDoc     String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assignedPo      String?
  status          String               @default("unreviewed")
  pbEpic          String?
  rejectionReason String?              @db.Text
  freezeReason    String?              @db.Text
  poHearingMemo   String?              @db.Text
  poReviewMemo    String?              @db.Text
  poFlag          String?
  sortOrder       Int                  @default(0)
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version         Int                  @default(0)
  deletedAt       DateTime?
  deletedById     String?
  attachments     IceboxAttachment[]
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  backlogItems    ProductBacklogItem[]

  @@unique([projectId, displayId])
  @@index([projectId])
  @@index([projectId, deletedAt])
  @@fulltext([request, background, pbEpic], map: "ft_icebox_text")
}

model IceboxAttachment {
  id           String     @id @default(cuid())
  iceboxItemId String
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  createdAt    DateTime   @default(now())
  iceboxItem   IceboxItem @relation(fields: [iceboxItemId], references: [id], onDelete: Cascade)

  @@index([iceboxItemId])
}

model ProductBacklogItem {
  id                 String                  @id @default(cuid())
  projectId          String
  displayId          Int
  iceboxItemId       String?
  initiative         String?
  epic               String?
  userStory          String?                 @db.Text
  acceptanceCriteria String?                 @db.Text
  referenceDoc       String?                 @db.Text
  workloadScore      Int                     @default(0)
  completedAt        DateTime?
  assignedPo         String?
  poNote             String?                 @db.Text
  status             String                  @default("not_ready")
  notReadyReason     String?                 @db.Text
  sortOrder          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  productGoalId      String?
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version            Int                     @default(0)
  deletedAt          DateTime?
  deletedById        String?
  /// Master-plan leaf this PBI contributes to (at most one).
  planItemId         String?
  iceboxItem         IceboxItem?             @relation(fields: [iceboxItemId], references: [id])
  planItem           PlanItem?               @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  productGoal        ProductGoal?            @relation(fields: [productGoalId], references: [id])
  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseItems       ReleaseBacklogItem[]
  sprintItems        SprintBacklogItem[]
  /// Finish-to-start links: PBIs that must be completed before this one ("blocked by").
  predecessorDeps    BacklogItemDependency[] @relation("PbiDependencySuccessor")
  /// PBIs waiting for this one.
  successorDeps      BacklogItemDependency[] @relation("PbiDependencyPredecessor")
  /// Files / images of the 参考資料 (reference material) section.
  attachments        PbiAttachment[]
  /// GitLab merge requests / branches / commits naming this PBI (PBI-<displayId>).
  gitLinks           GitLink[]

  @@unique([projectId, displayId])
  @@index([projectId])
  @@index([projectId, deletedAt])
  @@index([iceboxItemId])
  @@index([productGoalId])
  @@index([planItemId])
  @@fulltext([initiative, epic, userStory, acceptanceCriteria], map: "ft_pbi_text")
}

/// File or image attached to a PBI's 参考資料 (reference material); stored
/// like the IceBox attachments (private/uploads/<projectId>/<fileName>).
model PbiAttachment {
  id            String             @id @default(cuid())
  backlogItemId String
  fileName      String
  originalName  String
  fileSize      Int
  mimeType      String
  createdAt     DateTime           @default(now())
  backlogItem   ProductBacklogItem @relation(fields: [backlogItemId], references: [id], onDelete: Cascade)

  @@index([backlogItemId])
  @@map("pbi_attachment")
}

/// Finish-to-start dependency between two PBIs of one project: the
/// predecessor must be completed before the successor can start. Advisory:
/// shown on the backlog / sprint pickers, nothing is blocked server-side.
model BacklogItemDependency {
  id            String   @id @default(cuid())
  projectId     String
  predecessorId String
  successorId   String
  createdAt     DateTime @default(now())

  predecessor ProductBacklogItem @relation("PbiDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ProductBacklogItem @relation("PbiDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([successorId])
  @@index([projectId])
}

/// When a user last confirmed a project's updates ("すべて確認済みにする").
/// Activity by others after lastSeenAt counts as new for that user.
model ProjectVisit {
  id         String   @id @default(cuid())
  userId     String
  projectId  String
  lastSeenAt DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

/// Project-wide team chat. A row is either a chat message (body set) or the
/// mirror of a PBI / sprint-task / IceBox comment (commentId set, body NULL:
/// the text is read from the comment so edits and deletes follow). A reply
/// to a mirrored comment is also posted to that comment's thread; the reply
/// row then keeps its own body and links the comment it created.
model TeamMessage {
  id          String                  @id @default(cuid())
  projectId   String
  authorId    String
  body        String?                 @db.Text
  commentId   String?                 @unique
  replyToId   String?
  createdAt   DateTime                @default(now())
  deletedAt   DateTime?
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User                    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  comment     Comment?                @relation(fields: [commentId], references: [id], onDelete: Cascade)
  replyTo     TeamMessage?            @relation("TeamMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     TeamMessage[]           @relation("TeamMessageReply")
  attachments TeamMessageAttachment[]
  mentions    TeamMessageMention[]

  @@index([projectId, createdAt])
  @@index([replyToId])
}

/// A file attached to a team chat message (stored like project attachments).
model TeamMessageAttachment {
  id           String      @id @default(cuid())
  messageId    String
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  createdAt    DateTime    @default(now())
  message      TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model TeamMessageMention {
  messageId String
  userId    String
  message   TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

/// When a user last read a project's team chat (unread = newer messages by others).
model TeamChatRead {
  id         String   @id @default(cuid())
  userId     String
  projectId  String
  lastReadAt DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model Sprint {
  id                   String              @id @default(cuid())
  projectId            String
  sprintName           String
  startDate            DateTime
  endDate              DateTime
  sprintGoal           String?             @db.Text
  capacity             Int                 @default(0)
  actualScore          Int                 @default(0)
  status               String              @default("planning")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  retrospectiveMemo    String?             @db.Text
  retrospectiveKeep    String?             @db.Text
  retrospectiveProblem String?             @db.Text
  retrospectiveTry     String?             @db.Text
  reviewComment        String?             @db.Text
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version              Int                 @default(0)
  calendarEvents       CalendarEvent[]
  dailyScrumNotes      DailyScrumNote[]
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items                SprintBacklogItem[]

  @@index([projectId])
}

model DailyScrumNote {
  id         String    @id @default(cuid())
  sprintId   String
  date       DateTime
  content    String    @db.Text
  author     String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sprint     Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId])
  @@index([sprintId, date])
  @@index([archivedAt])
}

model SprintBacklogItem {
  id                String             @id @default(cuid())
  sprintId          String
  pbItemId          String
  taskName          String?
  assignee          String?
  estimatedHours    Float?
  actualHours       Float?
  status            String             @default("todo")
  completedAt       DateTime?
  completionComment String?            @db.Text
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version           Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  pbItem            ProductBacklogItem @relation(fields: [pbItemId], references: [id], onDelete: Cascade)
  sprint            Sprint             @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  /// Normalized assignees (P2). The legacy `assignee` string (comma-separated
  /// names) stays during the transition; backfilled by scripts/migrate-assignees.ts.
  assignees         TaskAssignee[]

  @@index([sprintId])
  @@index([pbItemId])
  @@fulltext([taskName], map: "ft_task_name")
}

model ReleaseBacklogItem {
  id              String               @id @default(cuid())
  projectId       String
  planVersion     String?
  pbItemId        String?
  iceboxId        String?
  initiative      String?
  epic            String?
  userStory       String?              @db.Text
  assignedPo      String?
  releaseVersion  String?
  releaseDate     DateTime?
  releaseNote     String?              @db.Text
  manualLink      String?              @db.Text
  poNote          String?              @db.Text
  status          String               @default("staged")
  /// 改善成果ボード (process_improvement projects only; the software screen ignores these).
  /// time | quality | cost | safety | other
  metricCategory  String?              @db.VarChar(20)
  metricName      String?              @db.VarChar(200)
  metricUnit      String?              @db.VarChar(20)
  /// Which way is better: "decrease" | "increase".
  direction       String               @default("decrease") @db.VarChar(10)
  baselineValue   Float?
  targetValue     Float?
  resultValue     Float?
  annualEffectYen Int?
  /// measuring | standardized | deploying | sustained | deferred
  kaizenStage     String               @default("measuring") @db.VarChar(20)
  standardizedAt  DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  pbItem          ProductBacklogItem?  @relation(fields: [pbItemId], references: [id], onDelete: SetNull)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rollouts        ImprovementRollout[]
  checks          ImprovementCheck[]
  photos          ImprovementPhoto[]

  @@index([projectId])
  @@index([pbItemId])
}

/// 横展開先 of an improvement (another line / plant the kaizen is copied to).
model ImprovementRollout {
  id            String             @id @default(cuid())
  releaseItemId String
  targetName    String             @db.VarChar(200)
  /// todo | doing | done
  status        String             @default("todo") @db.VarChar(10)
  doneAt        DateTime?
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  releaseItem   ReleaseBacklogItem @relation(fields: [releaseItemId], references: [id], onDelete: Cascade)

  @@index([releaseItemId, sortOrder])
  @@map("improvement_rollout")
}

/// 定着確認 (sustainment check) of an improvement, e.g. 1 and 3 months after 展開日.
model ImprovementCheck {
  id            String             @id @default(cuid())
  releaseItemId String
  dueDate       DateTime
  /// 1m | 3m | custom
  kind          String             @db.VarChar(10)
  checkedAt     DateTime?
  /// sustained | regressed | null (not checked yet)
  result        String?            @db.VarChar(10)
  note          String?            @db.Text
  checkedById   String?
  checkedByName String?
  /// Set once the PO reminder for a due check was sent (worker collab-daily).
  notifiedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  releaseItem   ReleaseBacklogItem @relation(fields: [releaseItemId], references: [id], onDelete: Cascade)

  @@index([releaseItemId])
  @@index([dueDate, checkedAt, notifiedAt])
  @@map("improvement_check")
}

/// Before / after photos of an improvement (stored like PbiAttachment).
model ImprovementPhoto {
  id            String             @id @default(cuid())
  releaseItemId String
  /// before | after
  phase         String             @db.VarChar(10)
  fileName      String
  originalName  String
  fileSize      Int
  mimeType      String
  createdAt     DateTime           @default(now())
  releaseItem   ReleaseBacklogItem @relation(fields: [releaseItemId], references: [id], onDelete: Cascade)

  @@index([releaseItemId, phase])
  @@map("improvement_photo")
}

model CalendarEvent {
  id          String    @id @default(cuid())
  projectId   String
  sprintId    String?
  title       String
  description String?   @db.Text
  date        DateTime
  endDate     DateTime?
  color       String    @default("blue")
  allDay      Boolean   @default(true)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sprintId])
}

model AttachmentFolder {
  id          String              @id @default(cuid())
  projectId   String
  parentId    String?
  name        String
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      AttachmentFolder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    AttachmentFolder[]  @relation("FolderTree")
  attachments ProjectAttachment[]

  @@index([projectId])
  @@index([parentId])
}

model ProjectAttachment {
  id           String            @id @default(cuid())
  projectId    String
  folderId     String?
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  uploadedBy   String?
  /// Set for a link entry (e.g. a GitLab repository): no stored file, the row opens this http(s) URL.
  linkUrl      String?           @db.VarChar(2048)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  folder       AttachmentFolder? @relation(fields: [folderId], references: [id])
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([folderId])
  @@index([folderId, sortOrder])
