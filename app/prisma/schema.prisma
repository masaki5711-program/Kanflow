generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                String                @id @default(cuid())
  name              String
  email             String                @unique
  password          String
  avatarUrl         String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  isActive          Boolean               @default(true)
  role              String                @default("member")
  /// Bumped to revoke every JWT issued for this user (deactivate / role change / password reset).
  tokenVersion      Int                   @default(0)
  language          String                @default("ja")
  employeeNumber    String?               @unique
  department        String?
  accounts          Account[]
  memberships       ProjectMember[]
  sessions          Session[]
  projectCategories UserProjectCategory[]
  sections          UserSection[]
  favoriteProjects  UserProjectFavorite[]
  fixedTasks        UserFixedTask[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  comments          Comment[]
  commentMentions   CommentMention[]
  taskAssignments   TaskAssignee[]

  @@index([department])
}

/// A user-defined group of related sprint sub-tasks. `taskName` is the group's
/// display name (e.g. "設備購入"); children in `items` are the concrete sub-tasks
/// that get bulk-inserted under a single PBI when the group is picked from
/// the dropdown in the sprint task form.
/// A row in the project's master plan ("全体計画") — independent of sprints
/// and PBIs. Supports unlimited nesting via parentId. Progress on non-leaf
/// items is auto-aggregated from children; leaf items take manual progress.
/// `status="delayed"` is set manually by the user to surface a red bar
/// regardless of actual dates.
model PlanItem {
  id            String     @id @default(cuid())
  projectId     String
  parentId      String?
  name          String     @db.VarChar(255)
  description   String?    @db.Text
  plannedStart  DateTime
  plannedEnd    DateTime
  actualStart   DateTime?
  actualEnd     DateTime?
  progressPct   Int        @default(0)
  color         String?    @db.VarChar(32)
  status        String     @default("not_started")
  sortOrder     Int        @default(0)
  isMilestone   Boolean    @default(false)
  notes         String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        PlanItem?  @relation("PlanItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      PlanItem[] @relation("PlanItemTree")

  @@index([projectId])
  @@index([parentId])
  @@index([projectId, sortOrder])
}

model UserFixedTask {
  id        String              @id @default(cuid())
  userId    String
  taskName  String
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     UserFixedTaskItem[]

  @@index([userId])
}

model UserFixedTaskItem {
  id        String        @id @default(cuid())
  groupId   String
  taskName  String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  group     UserFixedTask @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id                  String                          @id @default(cuid())
  name                String
  description         String?                         @db.Text
  status              String                          @default("active")
  defaultCapacity     Int                             @default(0)
  sprintDurationDays  Int                             @default(7)
  pointUnit           String                          @default("SP")
  pointDescription    String?                         @db.Text
  language            String                          @default("ja")
  // Team option: when true, saved free-text fields are auto-annotated with a
  // Japanese/Indonesian bilingual rendering (lib/ensure-bilingual.ts)
  bilingualMode       Boolean                         @default(false)
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  projectType         String                          @default("software")
  progressPct         Int                             @default(0)
  // Card tint on the project list: gray|red|orange|yellow|green|blue|indigo|purple|pink; null = default white
  cardColor           String?
  // Soft delete (trash). Null = live. deletedById is a plain User id (no FK,
  // like CalendarEvent.createdBy); ActivityLog holds the full audit trail.
  deletedAt           DateTime?
  deletedById         String?
  attachmentFolders   AttachmentFolder[]
  calendarEvents      CalendarEvent[]
  iceboxItems         IceboxItem[]
  backlogItems        ProductBacklogItem[]
  productGoals        ProductGoal[]
  attachments         ProjectAttachment[]
  members             ProjectMember[]
  releaseItems        ReleaseBacklogItem[]
  sprints             Sprint[]
  sections            ProjectSection[]
  categoryAssignments UserProjectCategoryAssignment[]
  adminCategoryAssignments AdminCategoryAssignment[]
  favoritedBy         UserProjectFavorite[]
  planItems           PlanItem[]
  aiReports           AiReport[]
  activityLogs        ActivityLog[]
  notifications       Notification[]
  comments            Comment[]

  @@index([deletedAt])
}

model AiReport {
  id        String   @id @default(cuid())
  projectId String
  // What fired the investigation: surveillance | sprint_completed | manual
  trigger   String
  status    String   @default("done")
  title     String
  // One-line summary for list views
  summary   String?  @db.Text
  // Full markdown report produced by the agent (fallback rendering)
  body      String?  @db.Text
  // JSON: StructuredReport submitted via the submit_report tool (report-tool.ts).
  // Null for legacy reports / plain-text endings — the UI then renders body.
  structured String? @db.Text
  // JSON: detected anomalies, tool call stats, duration ms
  meta      String?  @db.Text
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Section {
  id          String                    @id @default(cuid())
  name        String                    @unique
  description String?                   @db.Text
  sortOrder   Int                       @default(0)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  users       UserSection[]
  projects    ProjectSection[]
  categories  AdminCategory[]
}

model ProjectSection {
  projectId  String
  sectionId  String
  assignedAt DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([projectId, sectionId])
  @@index([projectId])
  @@index([sectionId])
}

model UserSection {
  userId     String
  sectionId  String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
}

model UserProjectFavorite {
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model AdminCategory {
  id          String                    @id @default(cuid())
  name        String
  color       String                    @default("gray")
  sortOrder   Int                       @default(0)
  sectionId   String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  section     Section?                  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignments AdminCategoryAssignment[]

  @@unique([sectionId, name])
  @@index([sectionId])
}

model AdminCategoryAssignment {
  id         String        @id @default(cuid())
  categoryId String
  projectId  String
  category   AdminCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([categoryId, projectId])
  @@index([categoryId])
  @@index([projectId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProductGoal {
  id           String               @id @default(cuid())
  projectId    String
  title        String               @db.Text
  description  String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  backlogItems ProductBacklogItem[]
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model IceboxItem {
  id              String               @id @default(cuid())
  projectId       String
  displayId       Int
  author          String
  request         String               @db.Text
  background      String?              @db.Text
  policyDoc       String?              @db.Text
  planningDoc     String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assignedPo      String?
  status          String               @default("unreviewed")
  pbEpic          String?
  rejectionReason String?              @db.Text
  freezeReason    String?              @db.Text
  poHearingMemo   String?              @db.Text
  poReviewMemo    String?              @db.Text
  poFlag          String?
  sortOrder       Int                  @default(0)
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version         Int                  @default(0)
  deletedAt       DateTime?
  deletedById     String?
  attachments     IceboxAttachment[]
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  backlogItems    ProductBacklogItem[]

  @@unique([projectId, displayId])
  @@index([projectId])
  @@index([projectId, deletedAt])
}

model IceboxAttachment {
  id           String     @id @default(cuid())
  iceboxItemId String
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  createdAt    DateTime   @default(now())
  iceboxItem   IceboxItem @relation(fields: [iceboxItemId], references: [id], onDelete: Cascade)

  @@index([iceboxItemId])
}

model ProductBacklogItem {
  id                 String               @id @default(cuid())
  projectId          String
  displayId          Int
  iceboxItemId       String?
  initiative         String?
  epic               String?
  userStory          String?              @db.Text
  acceptanceCriteria String?              @db.Text
  referenceDoc       String?              @db.Text
  workloadScore      Int                  @default(0)
  completedAt        DateTime?
  assignedPo         String?
  poNote             String?              @db.Text
  status             String               @default("not_ready")
  notReadyReason     String?              @db.Text
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  productGoalId      String?
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version            Int                  @default(0)
  deletedAt          DateTime?
  deletedById        String?
  iceboxItem        IceboxItem?          @relation(fields: [iceboxItemId], references: [id])
  productGoal        ProductGoal?         @relation(fields: [productGoalId], references: [id])
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releaseItems       ReleaseBacklogItem[]
  sprintItems        SprintBacklogItem[]

  @@unique([projectId, displayId])
  @@index([projectId])
  @@index([projectId, deletedAt])
  @@index([iceboxItemId])
  @@index([productGoalId])
}

model Sprint {
  id                String              @id @default(cuid())
  projectId         String
  sprintName        String
  startDate         DateTime
  endDate           DateTime
  sprintGoal        String?             @db.Text
  capacity          Int                 @default(0)
  actualScore       Int                 @default(0)
  status            String              @default("planning")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  retrospectiveMemo String?             @db.Text
  retrospectiveKeep String?             @db.Text
  retrospectiveProblem String?          @db.Text
  retrospectiveTry  String?             @db.Text
  reviewComment     String?             @db.Text
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version           Int                 @default(0)
  calendarEvents    CalendarEvent[]
  dailyScrumNotes   DailyScrumNote[]
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items             SprintBacklogItem[]

  @@index([projectId])
}

model DailyScrumNote {
  id         String    @id @default(cuid())
  sprintId   String
  date       DateTime
  content    String    @db.Text
  author     String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sprint     Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId])
  @@index([sprintId, date])
  @@index([archivedAt])
}

model SprintBacklogItem {
  id                 String             @id @default(cuid())
  sprintId           String
  pbItemId           String
  taskName           String?
  assignee           String?
  estimatedHours     Float?
  actualHours        Float?
  status             String             @default("todo")
  completedAt        DateTime?
  completionComment  String?            @db.Text
  /// Optimistic-lock counter: bumped on every update; stale writes get 409.
  version            Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  pbItem         ProductBacklogItem @relation(fields: [pbItemId], references: [id], onDelete: Cascade)
  sprint         Sprint             @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  /// Normalized assignees (P2). The legacy `assignee` string (comma-separated
  /// names) stays during the transition; backfilled by scripts/migrate-assignees.ts.
  assignees      TaskAssignee[]

  @@index([sprintId])
  @@index([pbItemId])
}

model ReleaseBacklogItem {
  id             String              @id @default(cuid())
  projectId      String
  planVersion    String?
  pbItemId       String?
  iceboxId       String?
  initiative     String?
  epic           String?
  userStory      String?             @db.Text
  assignedPo     String?
  releaseVersion String?
  releaseDate    DateTime?
  releaseNote    String?             @db.Text
  manualLink     String?             @db.Text
  poNote         String?             @db.Text
  status         String              @default("staged")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  pbItem         ProductBacklogItem? @relation(fields: [pbItemId], references: [id], onDelete: SetNull)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([pbItemId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  projectId   String
  sprintId    String?
  title       String
  description String?   @db.Text
  date        DateTime
  endDate     DateTime?
  color       String    @default("blue")
  allDay      Boolean   @default(true)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sprintId])
}

model AttachmentFolder {
  id          String              @id @default(cuid())
  projectId   String
  parentId    String?
  name        String
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      AttachmentFolder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    AttachmentFolder[]  @relation("FolderTree")
  attachments ProjectAttachment[]

  @@index([projectId])
  @@index([parentId])
}

model ProjectAttachment {
  id           String            @id @default(cuid())
  projectId    String
  folderId     String?
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  uploadedBy   String?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  folder       AttachmentFolder? @relation(fields: [folderId], references: [id])
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([folderId])
  @@index([folderId, sortOrder])
}

model UserProjectCategory {
  id          String                          @id @default(cuid())
  userId      String
  name        String
  color       String                          @default("gray")
  sortOrder   Int                             @default(0)
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt
  user        User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments UserProjectCategoryAssignment[]

  @@unique([userId, name])
  @@index([userId])
}

model UserProjectCategoryAssignment {
  id         String              @id @default(cuid())
  categoryId String
  projectId  String
  category   UserProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([categoryId, projectId])
  @@index([categoryId])
  @@index([projectId])
}

/// Both-language storage for user-entered free text (src/lib/translation).
/// One row per (entity, field). The row doubles as the background-translation
/// queue: status / priority / attempts live here, there is no separate queue.
/// The source-locale column holds the original text verbatim; the other side
/// is filled by the background worker (or by the legacy bilingual-pair split).
model FieldTranslation {
  entityType   String    @map("entity_type") @db.VarChar(64)
  entityId     String    @map("entity_id") @db.VarChar(191)
  field        String    @db.VarChar(64)
  sourceLocale String    @map("source_locale") @db.Char(2)
  sourceHash   String    @map("source_hash") @db.VarChar(64)
  textJa       String?   @map("text_ja") @db.Text
  textId       String?   @map("text_id") @db.Text
  status       String    @default("pending") @db.VarChar(16)
  priority     Int       @default(0)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error") @db.Text
  model        String?   @db.VarChar(128)
  requestedAt  DateTime  @default(now()) @map("requested_at")
  startedAt    DateTime? @map("started_at")
  translatedAt DateTime? @map("translated_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@id([entityType, entityId, field])
  @@index([status, priority(sort: Desc), requestedAt])
  @@map("field_translation")
}

/// Shared translation glossary: a correction by one user is applied to every
/// later translation. Registered from `用語<<訳語>>` markup in any text input
/// or from /admin/glossary. (source, target, term_norm) is unique; the reverse
/// direction is auto-registered (auto_reverse=true) until edited by hand.
model Glossary {
  id           String   @id @default(cuid())
  sourceLocale String   @map("source_locale") @db.Char(2)
  targetLocale String   @map("target_locale") @db.Char(2)
  term         String   @db.VarChar(255)
  termNorm     String   @map("term_norm") @db.VarChar(255)
  translation  String   @db.VarChar(500)
  note         String?  @db.Text
  autoReverse  Boolean  @default(false) @map("auto_reverse")
  usageCount   Int      @default(0) @map("usage_count")
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([sourceLocale, targetLocale, termNorm])
  @@index([sourceLocale, targetLocale])
  @@map("glossary")
}

// ---------------------------------------------------------------------------
// P2 collaboration foundation (migration 20261002000000_p2_collab_foundation)
// Table/column naming follows the core models (PascalCase table = model name,
// camelCase columns, cuid ids), not the snake_case translation tables.
// ---------------------------------------------------------------------------

/// Audit / change history. One row per mutation of a tracked entity.
/// entityType: project | pbi | sprint | sprint_task | icebox | comment | ...
/// action: create | update | delete | restore | status_change | ...
/// actorName is denormalized so history stays readable if the actor is gone.
/// diff is a JSON string ({ field: [before, after] }) — Text, like the other
/// JSON-in-Text columns (AiReport.structured / meta).
model ActivityLog {
  id         String   @id @default(cuid())
  projectId  String
  entityType String   @db.VarChar(32)
  entityId   String   @db.VarChar(191)
  action     String   @db.VarChar(32)
  actorId    String?
  actorName  String?
  diff       String?  @db.Text
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

/// In-app notification (bell). payload is a JSON string rendered client-side.
/// dedupeKey (e.g. "due_soon:<taskId>:2026-10-02") makes scheduled jobs
/// idempotent: a repeat insert with the same (recipientId, dedupeKey) fails
/// with P2002 and is skipped. NULL keys never collide (MySQL unique semantics),
/// so ad-hoc notifications simply leave it null.
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  type        String    @db.VarChar(32)
  entityType  String?   @db.VarChar(32)
  entityId    String?   @db.VarChar(191)
  projectId   String?
  payload     String?   @db.Text
  dedupeKey   String?   @db.VarChar(191)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt])
  @@index([projectId])
}

/// Per-user opt-out per notification type. Missing row = enabled.
model NotificationPreference {
  userId  String
  type    String  @db.VarChar(32)
  enabled Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

/// Comment thread on a PBI / sprint task / icebox request (polymorphic:
/// entityType = pbi | sprint_task | icebox, entityId = that row's id).
/// Soft-deleted comments keep their row (deletedAt) so thread order and
/// mentions stay intact. author is Restrict: users are deactivated, never
/// deleted, and a comment must not silently vanish with its author.
model Comment {
  id         String           @id @default(cuid())
  projectId  String
  entityType String           @db.VarChar(32)
  entityId   String           @db.VarChar(191)
  authorId   String
  body       String           @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  editedAt   DateTime?
  deletedAt  DateTime?
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  mentions   CommentMention[]

  @@index([entityType, entityId, createdAt])
  @@index([projectId, createdAt])
  @@index([authorId])
}

/// @mentions parsed from Comment.body (drives mention notifications).
model CommentMention {
  commentId String
  userId    String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

/// Normalized sprint-task assignee (replaces the comma-separated
/// SprintBacklogItem.assignee string; backfill: scripts/migrate-assignees.ts).
model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime          @default(now())
  task      SprintBacklogItem @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}
