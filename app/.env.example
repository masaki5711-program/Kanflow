# Database
DATABASE_URL="mysql://scrum_app:PASSWORD@localhost:3306/scrum_tool"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=scrum_app
DATABASE_PASSWORD=  # REQUIRED: Set a strong password
DATABASE_NAME=scrum_tool

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=  # REQUIRED: Generate with `openssl rand -base64 32`

# Docker MySQL
MYSQL_ROOT_PASSWORD=  # REQUIRED: Set a strong root password
MYSQL_APP_USER=scrum_app
MYSQL_APP_PASSWORD=  # REQUIRED: Same as DATABASE_PASSWORD

# Collabora Online (document editing)
NEXT_PUBLIC_COLLABORA_URL=http://localhost:9980
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=  # REQUIRED: Set a strong password

# WOPI token (Collabora ↔ App authentication)
WOPI_ACCESS_TOKEN=  # REQUIRED: Generate with `openssl rand -hex 32`

# App URLs
APP_PUBLIC_URL=http://localhost:3000
APP_EXTERNAL_URL=http://host.docker.internal:3000  # URL Collabora uses to reach the app

# ──────────────────────────────────────────
# Production overrides (example)
# ──────────────────────────────────────────
# NEXTAUTH_URL=https://kanflow.example.com
# NEXT_PUBLIC_COLLABORA_URL=https://collabora.example.com
# APP_PUBLIC_URL=https://kanflow.example.com
# APP_EXTERNAL_URL=https://kanflow.example.com
