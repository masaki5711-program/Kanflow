# =====================================================================
#  Kanflow - app/.env template
#  Copy to app/.env and fill in. PLACEHOLDERS ONLY in this file - never
#  commit real values. app/.env is read by `next start` (the kanflow.exe
#  service), by the standalone worker, by prisma.config.ts and by the ops
#  scripts (backup / surveillance), so keep it in this one place.
#  Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =====================================================================

# ---------------------------------------------------------------------
# Database (native MySQL 8.4 Windows service "KanflowMySQL", 127.0.0.1)
# ---------------------------------------------------------------------
# Used by Prisma CLI (prisma.config.ts: migrate deploy / migrate diff).
# URL-encode special characters in the password.
DATABASE_URL="mysql://scrum_app:CHANGE_ME@127.0.0.1:3306/scrum_tool"
# Used by the running app (src/lib/prisma.ts, MariaDB driver adapter) and by
# ops/backup/*.ps1. Keep them consistent with DATABASE_URL.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=scrum_app
# REQUIRED in production (no default).
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=scrum_tool

# ---------------------------------------------------------------------
# Auth.js / NextAuth v5
# ---------------------------------------------------------------------
# REQUIRED. JWT signing secret (either name works; AUTH_SECRET is the v5 name).
AUTH_SECRET=CHANGE_ME_64_HEX_CHARS
# NEXTAUTH_SECRET=CHANGE_ME_64_HEX_CHARS
# Public base URL users open (hostname, not a LAN IP).
NEXTAUTH_URL=http://kanflow-host.example.local:3000
# Trust the Host header (required when served on a hostname/IP other than NEXTAUTH_URL).
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------
# Collabora Online (document editing via WOPI)
# ---------------------------------------------------------------------
# Browser-facing Collabora URL (also added to the CSP in next.config.ts).
NEXT_PUBLIC_COLLABORA_URL=http://kanflow-host.example.local:9980
# Server-to-server Collabora URL (discovery). Defaults to NEXT_PUBLIC_COLLABORA_URL.
COLLABORA_INTERNAL_URL=http://127.0.0.1:9980
# URL the Collabora CONTAINER uses to call back into the app (WOPI host).
# Must also be listed as an aliasgroup in docker-compose-collabora.yml.
APP_EXTERNAL_URL=http://host.docker.internal:3000
# WOPI access-token signing secret. Falls back to AUTH_SECRET/NEXTAUTH_SECRET if empty.
WOPI_ACCESS_TOKEN=CHANGE_ME_64_HEX_CHARS
# Collabora monitoring by /api/health ("collabora": ok | unreachable | disabled,
# never changes the HTTP status) and by the watchdog (alert + "docker start" of a
# stopped kanflow-collabora container). "off" disables both (Collabora not used).
# COLLABORA_MONITOR=on
# Public URL users open. Read by next.config.ts AT BUILD TIME: when it starts
# with https:// the Strict-Transport-Security (HSTS) header is sent. Leave it
# http:// (or unset) while Kanflow is served over plain HTTP - HSTS on an
# http-only host locks browsers out. Rebuild after changing it.
# APP_PUBLIC_URL=http://kanflow-host.example.local:3000

# ---------------------------------------------------------------------
# Local AI (Ollama)
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default model for callers that do not name a role.
OLLAMA_MODEL=qwen3.8:27b-q4_K_M
# Role-specific models (defaults shown).
OLLAMA_MODEL_ANALYSIS=qwen3.8:27b-q4_K_M
OLLAMA_MODEL_TRANSLATE=qwen3.8:27b-q4_K_M
OLLAMA_MODEL_VISION=qwen2.5vl:7b
# Context window per request. Keep equal to OLLAMA_CONTEXT_LENGTH in
# setup/start-ollama.bat AND to the num_ctx BankMasalah sends for the same
# model: Ollama reloads the model (8-10 s) whenever num_ctx changes between
# requests. Web and worker read this same file, so they always match.
OLLAMA_NUM_CTX=12288
# Max simultaneous Ollama requests PER PROCESS (web and worker each). Keep
# <= OLLAMA_NUM_PARALLEL in setup/start-ollama.bat (2). Default 2.
# OLLAMA_MAX_CONCURRENCY=2
# Per-use request timeouts in ms (whole call incl. waiting for a slot).
# OLLAMA_TIMEOUT_CHAT_MS=240000
# OLLAMA_TIMEOUT_REPORT_MS=300000
# OLLAMA_TIMEOUT_FIELD_MS=90000
# OLLAMA_TIMEOUT_DEFAULT_MS=300000
# keep_alive sent with each request (default 168h).
OLLAMA_KEEP_ALIVE_PER_REQUEST=168h

# ---------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------
# FULLTEXT (ngram) search for the global search and the chat's
# search_work_items tool: on | off (default on). Needs migration
# 20261003010000_fulltext_search; without the indexes the app falls back to
# LIKE automatically (logged once). "off" forces the LIKE search.
# SEARCH_FULLTEXT=on

# English side of rows translated before English existed: filled one row at a
# time only inside this local-time window ("19-7" default, "always", "off").
# TRANSLATION_EN_BACKFILL_HOURS=19-7

# Daily housekeeping (due-date notifications, retention, 定着確認 reminders) in the
# web process when there is no standalone worker: auto (default: only with
# AI_TRANSLATION_WORKER=inprocess in production), on, off.
# WEB_DAILY_JOBS=auto

# ---------------------------------------------------------------------
# GitLab integration (per project, off by default; docs/operations/git-integration.md)
# ---------------------------------------------------------------------
# Polling interval in seconds (min 60). GitLab cannot reach the LAN: no webhooks.
# GIT_SYNC_INTERVAL_SEC=180
# off = no background sync in this process. `next dev` needs GIT_SYNC_IN_DEV=true.
# GIT_SYNC=on
# GIT_SYNC_IN_DEV=false
# Hosts repositories may live on (comma separated). Guards against calling other URLs with a token.
# GIT_ALLOWED_HOSTS=gitlab.scm.service.infosys.yamaha.com
# Key for sealing stored access tokens (any long random string). Defaults to a key
# derived from AUTH_SECRET; changing either makes saved tokens unreadable (re-enter them).
# INTEGRATION_SECRET_KEY=

# ---------------------------------------------------------------------
# Background translation / standalone worker
# ---------------------------------------------------------------------
# external (default) = only the standalone worker process translates
# inprocess          = every `next start` process runs the loop (pre-2026-09 behaviour)
# off                = nobody translates
AI_TRANSLATION_WORKER=external
# `next dev` only: also run the in-process loop in dev (true/false).
# AI_TRANSLATION_WORKER_IN_DEV=false
# Shared secret between worker and web process (/api/internal/*, loopback only).
INTERNAL_API_TOKEN=CHANGE_ME_64_HEX_CHARS
# AI priority gate tuning (defaults shown). PEERS: comma-separated web base URLs, or "none".
# AI_GATE_PEERS=http://127.0.0.1:3000
# AI_GATE_POLL_MS=1000
# AI_GATE_TIMEOUT_MS=800
# AI_GATE_MAX_BACKOFF_MS=30000
# AI_GATE_QUIET_MS=3000
# AI_GATE_DEGRADED_INTERVAL_MS=30000
# PORT=3000
# Worker lifecycle (defaults shown).
# WORKER_HEARTBEAT_MS=60000
# WORKER_SHUTDOWN_TIMEOUT_MS=25000
# Liveness file the worker rewrites every heartbeat; /api/health, the watchdog
# and ops/status.ps1 read it (worker: ok | stale | absent). Default <LOG_DIR>/worker-heartbeat.json.
# WORKER_HEARTBEAT_FILE=D:/APP/Kanflow/app/logs/worker-heartbeat.json
# Heartbeat counts as stale after max(3 x WORKER_HEARTBEAT_MS, this) ms.
# WORKER_HEARTBEAT_STALE_MS=180000
# Office-hours throttle for BACKGROUND translation (user AI calls are never
# throttled): inside the window at most WORKER_BUSINESS_HOURS_RATE rows per
# rolling minute (0 = pause), so chat users and BankMasalah (same Ollama)
# are not slowed down. "off" disables. Local time; days are ISO (1=Mon..7=Sun).
# WORKER_BUSINESS_HOURS=08:00-17:30
# WORKER_BUSINESS_DAYS=1-5
# WORKER_BUSINESS_HOURS_RATE=6

# ---------------------------------------------------------------------
# AI surveillance (daily anomaly check + LLM investigation)
# ---------------------------------------------------------------------
# REQUIRED for POST /api/surveillance (header x-surveillance-token) and
# ops/surveillance/run-ai-surveillance.ps1.
SURVEILLANCE_TOKEN=CHANGE_ME_64_HEX_CHARS
# Worker-internal schedule: comma-separated local HH:MM, or "off". Default 06:30.
# Do NOT also register the KanflowAiSurveillance scheduled task when the worker schedules it.
# SURVEILLANCE_SCHEDULE=06:30
# AI report retention (days) — the ONLY setting that deletes AiReport rows.
# AI_REPORT_RETENTION_DAYS is accepted as an alias when this is unset.
# SURVEILLANCE_RETENTION_DAYS=90
# Max wait for busy web users before a scheduled run starts a project anyway (ms).
# SURVEILLANCE_YIELD_MAX_MS=600000
# Agent investigations per run (the rest of the projects get deterministic checks only). Default 3.
# Per-project thresholds (enable, stalled days, ...) are set in the project settings UI (PO / admin).
# SURVEILLANCE_MAX_INVESTIGATIONS=3

# ---------------------------------------------------------------------
# Background AI report jobs (AiJob queue: progress report, sprint review)
# ---------------------------------------------------------------------
# Where jobs run: auto (default) follows AI_TRANSLATION_WORKER
# (external -> the worker, inprocess -> every `next start`, off -> nobody);
# or force worker | web | off. With no runner ("off") the dashboard falls
# back to the synchronous streaming progress report.
# AI_JOB_RUNNER=auto
# Queue poll interval (ms). Default 5000.
# AI_JOB_POLL_MS=5000
# A "running" job older than this belongs to a dead process: requeued once,
# then failed (ms). Default 1800000 (30 min).
# AI_JOB_STALE_MS=1800000
# Max wait for busy users before a job starts anyway (ms). Default 600000.
# AI_JOB_YIELD_MAX_MS=600000
# Finished jobs (done / failed / cancelled) older than this are deleted by the collab job. Default 30.
# AI_JOB_RETENTION_DAYS=30

# ---------------------------------------------------------------------
# Chat history (ChatThread / ChatMessage) — retention by the collab job
# ---------------------------------------------------------------------
# Threads without a new message for this many days are deleted. Default 180.
# CHAT_RETENTION_DAYS=180
# Threads the user deleted are purged this many days later. Default 30.
# CHAT_DELETED_RETENTION_DAYS=30

# ---------------------------------------------------------------------
# Activity log + notifications (worker "collab-daily" job)
# ---------------------------------------------------------------------
# Daily local HH:MM time(s) of the collab job: retention sweep, then
# due_soon / overdue notifications. "off" disables BOTH. Default 07:45.
# NOTIFY_DUE_SCHEDULE=07:45
# "Due soon" = due (sprint end for tasks, plannedEnd for plan items) within
# today .. today + N days. Default 2.
# NOTIFY_DUE_SOON_DAYS=2
# 改善成果ボード (process_improvement projects): the same collab job reminds
# the project's PO(s) once when a 定着確認 (1 / 3 months after 展開日, or a
# custom date) is due and not recorded yet. "off" disables. Default on.
# IMPROVEMENT_CHECK_REMINDERS=on
# ActivityLog rows older than this are deleted. Default 730 (2 years).
# ACTIVITY_RETENTION_DAYS=730
# READ notifications older than this are deleted (unread ones are kept). Default 90.
# NOTIFICATION_RETENTION_DAYS=90

# ---------------------------------------------------------------------
# Trash (soft delete) — worker "purge-trash" job
# ---------------------------------------------------------------------
# Deleted projects / PBIs / IceBox items stay in the trash (restorable) for
# this many days, then the worker deletes them permanently (rows, files and
# translations). Also shown as the "purge on" date in the trash UI, so set
# it in the web env too. Default 30.
# PURGE_TRASH_AFTER_DAYS=30
# Daily local HH:MM time(s) of the purge job. "off" disables it (the trash
# then grows until purged by hand). Default 03:15.
# PURGE_TRASH_SCHEDULE=03:15

# ---------------------------------------------------------------------
# Attachments
# ---------------------------------------------------------------------
# Per-project storage quota in MB (project files + icebox attachments),
# checked before each upload. 0 = unlimited. Default 5120 (5 GB).
# ATTACHMENT_PROJECT_QUOTA_MB=5120

# ---------------------------------------------------------------------
# Ops: alerts + backup (read by ops/*.ps1 only; the process environment
# overrides these values). See docs/operations/runbook.md section 8.
# ---------------------------------------------------------------------
# Every alert goes to ops/logs/alerts.log and the Windows Application event log
# (source "Kanflow"; created on first alert by a SYSTEM/admin task). Optional:
# SMTP relay (no authentication) and a generic JSON webhook (has a "text" field).
# KANFLOW_ALERT_SMTP_HOST=smtp-relay.example.local
# KANFLOW_ALERT_SMTP_PORT=25
# KANFLOW_ALERT_SMTP_SSL=false
# KANFLOW_ALERT_FROM=kanflow@example.local
# KANFLOW_ALERT_TO=ops1@example.local,ops2@example.local
# KANFLOW_ALERT_WEBHOOK_URL=https://hooks.example.local/CHANGE_ME
# Same alert key is not re-sent within N minutes (default 60).
# KANFLOW_ALERT_THROTTLE_MIN=60
# "off" disables the event log channel.
# KANFLOW_ALERT_EVENTLOG=on
# Directory for alerts.log + alert-state.json (default ops/logs).
# KANFLOW_ALERT_DIR=D:/APP/Kanflow/ops/logs
# REQUIRED for the scheduled backup: off-machine copy (NAS/UNC). Without it the
# backup still runs locally but alerts "secondary backup not configured" every run.
# KANFLOW_BACKUP_SECONDARY_DIR=\\nas01\backup\kanflow

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
# Directory for app log files (default <app>/logs). Daily files, pruned after LOG_RETENTION_DAYS.
# LOG_DIR=D:/APP/Kanflow/app/logs
# LOG_RETENTION_DAYS=14
# debug | info | warn | error (default info)
# LOG_LEVEL=info
# Max characters of free text kept per log field after redaction.
# LOG_MAX_TEXT=500
# AI monitor feed (demo/start-ai-monitor.bat). Default <LOG_DIR>/ai-activity.log
# AI_ACTIVITY_LOG=D:/APP/Kanflow/ai-activity.log
# Include (truncated) user text in the AI monitor feed: true/false, max chars.
# AI_LOG_USER_TEXT=true
# AI_LOG_USER_TEXT_MAX=60

# ---------------------------------------------------------------------
# REST API (/api/v1) + Kanflow MCP (/api/mcp) + personal access tokens
# (docs/api-v1.md, docs/mcp.md)
# ---------------------------------------------------------------------
# off = /api/v1 and /api/mcp answer 403 and tokens cannot be created (default on).
# API_TOKENS_ENABLED=on
# Active tokens per user (default 5).
# API_TOKEN_MAX_PER_USER=5
# Allow tokens without an expiry (default false: 30 / 90 / 365 days only).
# API_TOKEN_ALLOW_NO_EXPIRY=false
# Requests per token per minute (default 120; each MCP HTTP request counts).
# API_V1_RATE_LIMIT_PER_MIN=120
# Writes per token per minute, on top of the request limit (default 30;
# REST POST / PATCH and MCP write tool calls).
# API_V1_WRITE_RATE_LIMIT_PER_MIN=30

# ---------------------------------------------------------------------
# Metrics (/admin/metrics)
# ---------------------------------------------------------------------
# off = no request metrics and no snapshots in this web process (default on).
# METRICS_ENABLED=on
# Snapshot interval in ms (min 60000, default 300000 = 5 min).
# METRICS_SNAPSHOT_INTERVAL_MS=300000
# MetricSnapshot rows older than this are deleted (default 14).
# METRICS_RETENTION_DAYS=14

# ---------------------------------------------------------------------
# Build / runtime (normally set on the command line, not here)
# ---------------------------------------------------------------------
# Build into a side directory so the served .next is never clobbered
# (web build first, then the worker bundle into <dir>/worker/main.cjs):
#   set NEXT_DIST_DIR=.next-new && npm run build && npm run build:worker
# Normally done by ops/deploy/deploy.ps1. Do NOT set it in this file: the
# running server and /api/health read BUILD_ID from .next.
# NEXT_DIST_DIR=.next
# Worker service only: alternative bundle path (default .next/worker/main.cjs).
# KANFLOW_WORKER_BUNDLE=.next/worker/main.cjs
# NODE_ENV is set to "production" by the kanflow.exe service definition.
