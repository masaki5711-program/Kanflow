# ===========================================
# Docker Compose environment variables
# Copy this file to .env and fill in values:
#   cp .env.example .env
# ===========================================

# MySQL
MYSQL_ROOT_PASSWORD=          # REQUIRED: Set a strong root password
MYSQL_DATABASE=scrum_tool
MYSQL_APP_USER=scrum_app
MYSQL_APP_PASSWORD=           # REQUIRED: Set the app DB password

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=              # REQUIRED: Generate with `openssl rand -base64 32`

# Collabora Online (optional)
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=     # Set a Collabora admin password

# Collabora / WOPI
NEXT_PUBLIC_COLLABORA_URL=http://localhost:9980
APP_EXTERNAL_URL=http://scrum-app:3000
