# ===========================================
# Docker Compose environment variables
# Copy this file to .env and fill in values:
#   cp .env.example .env
# ===========================================

# PostgreSQL (Kanflow v2). The app itself reads app/.env (DATABASE_URL and
# DATABASE_HOST/PORT/USER/PASSWORD/NAME = postgresql://...); keep these in
# sync with it. Local / test database: ops/test-env/compose.yml (synthetic
# credentials, 127.0.0.1:25434). Production stays on MySQL 8.4 until the
# approved cutover (MR K2).
POSTGRES_DB=scrum_tool
POSTGRES_USER=scrum_app
POSTGRES_PASSWORD=            # REQUIRED: Set the app DB password

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=              # REQUIRED: Generate with `openssl rand -base64 32`

# Collabora Online (optional)
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=     # Set a Collabora admin password

# Collabora / WOPI
NEXT_PUBLIC_COLLABORA_URL=http://localhost:9980
APP_EXTERNAL_URL=http://scrum-app:3000
