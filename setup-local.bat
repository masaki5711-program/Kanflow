@echo off
chcp 65001 >nul 2>&1
setlocal enabledelayedexpansion

echo ============================================
echo   Scrum Tool (KanFlow) - ローカルセットアップ
echo   （Docker不要）
echo ============================================
echo.

:: -----------------------------------------------
:: 1. 前提条件チェック
:: -----------------------------------------------
echo [1/6] 前提条件を確認中...

where git >nul 2>&1
if %errorlevel% neq 0 (
    echo [ERROR] Git がインストールされていません。
    echo         https://git-scm.com/downloads からインストールしてください。
    goto :error
)
echo   [OK] Git

where node >nul 2>&1
if %errorlevel% neq 0 (
    echo [ERROR] Node.js がインストールされていません。
    echo         https://nodejs.org/ から v20 以上をインストールしてください。
    goto :error
)
for /f "tokens=*" %%v in ('node -v') do set NODE_VER=%%v
echo   [OK] Node.js %NODE_VER%

where npm >nul 2>&1
if %errorlevel% neq 0 (
    echo [ERROR] npm がインストールされていません。
    goto :error
)
echo   [OK] npm

where mysql >nul 2>&1
if %errorlevel% neq 0 (
    echo [WARN] mysql コマンドが見つかりません。
    echo        MySQL 8.0 がインストールされていることを確認してください。
    echo        https://dev.mysql.com/downloads/installer/
    echo.
    echo        既にインストール済みの場合は PATH を通してください。
    echo        続行しますか？
    pause
) else (
    echo   [OK] MySQL client
)

echo.

:: -----------------------------------------------
:: 2. リポジトリ取得
:: -----------------------------------------------
echo [2/6] リポジトリを取得中...

set REPO_URL=https://gitlab.scm.service.infosys.yamaha.com/ymma/stragegic-planning/appications/kanflow.git
set APP_DIR=kanflow

if exist "%APP_DIR%\.git" (
    echo   既にクローン済み。最新を取得します...
    pushd "%APP_DIR%"
    git pull origin main
    popd
) else if exist "%APP_DIR%" (
    echo [ERROR] %APP_DIR% フォルダが既に存在しますが、Gitリポジトリではありません。
    goto :error
) else (
    git clone %REPO_URL% %APP_DIR%
)

if %errorlevel% neq 0 (
    echo [ERROR] リポジトリの取得に失敗しました。
    goto :error
)
echo   [OK] リポジトリ取得完了
echo.

:: -----------------------------------------------
:: 3. MySQL データベース作成
:: -----------------------------------------------
echo [3/6] MySQL データベースをセットアップ中...
echo.
echo   MySQL root パスワードを入力してください。
echo   （MySQL インストール時に設定したパスワード）
echo.

set /p MYSQL_ROOT_PW="  MySQL root パスワード: "

:: DB とユーザーを作成
echo   データベースとユーザーを作成中...

set "CHARS=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
call :generate_password APP_DB_PW

mysql -u root -p%MYSQL_ROOT_PW% -e "CREATE DATABASE IF NOT EXISTS scrum_tool CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>nul
if %errorlevel% neq 0 (
    echo [ERROR] MySQL への接続に失敗しました。
    echo         MySQL が起動しているか、パスワードが正しいか確認してください。
    goto :error
)

mysql -u root -p%MYSQL_ROOT_PW% -e "CREATE USER IF NOT EXISTS 'scrum_app'@'localhost' IDENTIFIED BY '!APP_DB_PW!';" 2>nul
mysql -u root -p%MYSQL_ROOT_PW% -e "GRANT ALL PRIVILEGES ON scrum_tool.* TO 'scrum_app'@'localhost'; FLUSH PRIVILEGES;" 2>nul

echo   [OK] データベース scrum_tool 作成完了
echo   [OK] ユーザー scrum_app 作成完了
echo.

:: -----------------------------------------------
:: 4. .env ファイル作成
:: -----------------------------------------------
pushd "%APP_DIR%\app"

echo [4/6] 環境設定ファイルを準備中...

if exist .env (
    echo   [OK] .env は既に存在します（スキップ）
    goto :skip_env
)

call :generate_password NEXTAUTH_SEC1
call :generate_password NEXTAUTH_SEC2

(
    echo # Auto-generated by setup-local.bat
    echo.
    echo # Database
    echo DATABASE_URL=mysql://scrum_app:!APP_DB_PW!@localhost:3306/scrum_tool
    echo DATABASE_HOST=localhost
    echo DATABASE_PORT=3306
    echo DATABASE_USER=scrum_app
    echo DATABASE_PASSWORD=!APP_DB_PW!
    echo DATABASE_NAME=scrum_tool
    echo.
    echo # NextAuth
    echo NEXTAUTH_URL=http://localhost:3000
    echo NEXTAUTH_SECRET=!NEXTAUTH_SEC1!!NEXTAUTH_SEC2!
    echo.
    echo # Collabora Online (optional - document editing)
    echo NEXT_PUBLIC_COLLABORA_URL=http://localhost:9980
    echo APP_EXTERNAL_URL=http://localhost:3000
) > .env

echo   [OK] app\.env を自動生成しました
:skip_env
echo.

:: -----------------------------------------------
:: 5. npm install & Prisma セットアップ
:: -----------------------------------------------
echo [5/6] 依存パッケージをインストール中...
echo   （初回は数分かかります...）
echo.

call npm ci
if %errorlevel% neq 0 (
    echo [ERROR] npm ci に失敗しました。
    goto :error_pop
)
echo   [OK] npm パッケージインストール完了

echo.
echo   Prisma クライアントを生成中...
call npx prisma generate --schema=prisma/schema.prisma
if %errorlevel% neq 0 (
    echo [ERROR] Prisma generate に失敗しました。
    goto :error_pop
)
echo   [OK] Prisma クライアント生成完了

echo.
echo   データベースマイグレーションを実行中...
call npx prisma migrate deploy --schema=prisma/schema.prisma
if %errorlevel% neq 0 (
    echo [ERROR] Prisma migrate に失敗しました。
    echo         MySQL が起動しているか確認してください。
    goto :error_pop
)
echo   [OK] マイグレーション完了
echo.

:: -----------------------------------------------
:: 6. アプリ起動
:: -----------------------------------------------
echo [6/6] アプリケーションを起動中...
echo.

echo ============================================
echo   セットアップ完了！
echo ============================================
echo.
echo   アプリ: http://localhost:3000
echo.
echo   開発モードで起動します...
echo   （停止するには Ctrl+C）
echo ============================================
echo.

call npm run dev

popd
endlocal
exit /b 0

:: -----------------------------------------------
:: パスワード生成サブルーチン (16文字)
:: -----------------------------------------------
:generate_password
set "_pw="
for /L %%i in (1,1,16) do (
    set /a "_idx=!random! %% 62"
    for %%j in (!_idx!) do set "_pw=!_pw!!CHARS:~%%j,1!"
)
set "%1=!_pw!"
exit /b

:error_pop
popd
:error
echo.
echo セットアップに失敗しました。上記のエラーを確認してください。
endlocal
pause
exit /b 1
